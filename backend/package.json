{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "Multi-tenant CRM SaaS backend",
  "main": "dist/main/server.js",
  "scripts": {
    "build": "node scripts/generate-prisma-client.js && tsc && tsc-alias",
    "start": "node dist/main/server.js",
    "dev": "ts-node -r tsconfig-paths/register src/main/server.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathPattern=tests/unit --forceExit",
    "test:integration": "jest --testPathPattern=tests/integration --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "prisma:generate": "prisma generate",
    "prisma:generate:mysql": "prisma generate --schema=prisma/schema.mysql.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "seed:superadmin": "ts-node -r tsconfig-paths/register scratch/seed-super-admin.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register scratch/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@prisma/client": "^6.9.0",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^6.9.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
