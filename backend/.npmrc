# Hostinger loads the app's environment, NODE_ENV=production included, before
# it runs "npm install", and npm then skips devDependencies. The build needs
# them (typescript, prisma, tsc-alias, the @types packages), so install them
# whatever NODE_ENV says. This also overrides a bare --omit=dev, so prune with
# "npm prune --omit=dev --include=prod".
include=dev
