/*
 * PostgreSQL is the active schema, and the one `prisma/migrations` is written
 * for — every migration in that folder emits `TIMESTAMP(3)`, `JSONB` and
 * double-quoted identifiers, so `prisma migrate deploy` only ever worked here.
 *
 * `schema.mysql.prisma` beside this file is the hand-maintained MySQL mirror
 * used by the Hostinger deployment, which is provisioned from
 * `nevacrm_full_import.sql` rather than from the migration history. The two
 * now differ ONLY in the `@db.Text` annotations MySQL needs for long strings —
 * the four array-shaped columns (tags, options, emailEventTypes,
 * emailRecipientRoles) are `Json` on both sides on purpose, so the
 * application code has exactly one shape to handle instead of branching per
 * provider. Any model change must be made in both, or the deployment drifts
 * from what the code expects.
 */
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Whether a workspace is allowed to operate.
///
/// This is the first Prisma-level enum in the schema — `UserRole` and the
/// various status fields are TypeScript enums over String columns. The
/// difference is deliberate: this value is closed, platform-controlled and
/// never user-supplied, and it gates login for an entire workspace. A bad
/// value here silently locks out or lets in a whole tenant, so the constraint
/// is worth having in the database rather than only in application code.
///
/// SUSPENDED retains all data. There is no value here meaning "deleted" —
/// hard deletion is deliberately not a thing this model can express.
enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                        String  @id
  name                      String
  urlSlug                   String  @unique
  requiresQuotationApproval Boolean @default(true)
  // Workspace branding, surfaced in the sidebar, settings and customer-facing pages.
  logoUrl                   String?
  coverImageUrl             String?

  // Company profile. Like the branding URLs above, these are presentation-only
  // and are read straight from Prisma rather than through the Tenant entity.
  registrationNumber String?
  addressLine        String?
  addressCity        String?
  addressState       String?
  addressPostalCode  String?
  contactEmail       String?
  contactPhone       String?

  // Localization. Unlike the fields above these drive real behaviour (money
  // formatting, and notifications later), so they DO live on the domain entity.
  // NOT NULL with defaults so the fallback lives here and nowhere else.
  currency   String @default("USD")
  locale     String @default("en-US")
  timezone   String @default("UTC")
  dateFormat String @default("MM/DD/YYYY")

  // Interface language for the workspace. Separate from `locale` above by
  // design: locale is how things are FORMATTED, this is what language they are
  // WRITTEN in. Also the only language source available for invitation emails,
  // whose recipients have no account yet.
  defaultLanguage String @default("en")

  // Whether the workspace may operate at all. Like the localization fields
  // above this drives real behaviour — it gates login and every tenant-scoped
  // request — so it lives on the domain entity too.
  //
  // Defaulting to ACTIVE is what makes the migration safe: every tenant that
  // exists today is by definition operating, and a nullable or SUSPENDED
  // default would either introduce a third "unknown" state for every read site
  // to handle or lock out live customers on deploy.
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  users                  User[]
  ownershipTransfers     OwnershipTransfer[]
  invitations            Invitation[]
  clients                Client[]
  customFieldDefinitions CustomFieldDefinition[]
  outcomeCategories      OutcomeCategory[]
  interactions           Interaction[]
  appointments           Appointment[]

  // Inventory
  categories     Category[]
  warehouses     Warehouse[]
  products       Product[]
  productImages  ProductImage[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  // Quotations
  quotations Quotation[]

  // Invoices
  invoices Invoice[]

  notifications        Notification[]
  notificationSettings NotificationSettings?

  // Integrations
  integrations Integration[]
}

/// Platform-wide default settings, applied to a workspace only at the moment
/// it is PROVISIONED — never retroactively to an existing tenant. See
/// EnterTenantUseCase's sibling, CreateTenantWithOwnerUseCase, which reads this
/// row (falling back to PlatformSettings.defaults() if it has never been saved)
/// when building a new Tenant.
///
/// Deliberately NOT a live default that existing tenants keep following: a
/// workspace's own settings, once created, are that workspace's property, and
/// changing this row must never silently move a paying customer's currency or
/// timezone out from under them. Reaching an existing tenant is a separate,
/// explicit action — the platform console's per-tenant bulk apply — not a side
/// effect of editing this row.
///
/// A genuine singleton: exactly one row, `id` fixed at 'platform' by
/// convention (see PrismaPlatformSettingsRepository) rather than modelled with
/// no primary key at all, so `upsert` has a stable target.
model PlatformSettings {
  id                        String  @id @default("platform")
  requiresQuotationApproval Boolean @default(true)
  currency                  String  @default("USD")
  locale                    String  @default("en-US")
  timezone                  String  @default("UTC")
  dateFormat                String  @default("MM/DD/YYYY")
  defaultLanguage           String  @default("en")
  updatedAt                 DateTime @updatedAt
}

/// Per-workspace notification policy.
///
/// §6.6 of the SRS makes every notification behaviour configurable per
/// business: which events fire, who receives email, how far ahead a reminder
/// goes out, how long to wait before chasing a quotation. All of that lives
/// here, in one row per tenant, rather than as a scatter of booleans on Tenant.
///
/// The row is OPTIONAL. A tenant with no row gets `NotificationSettings.defaults()`
/// — see the domain entity. That is what makes this migration safe: no backfill
/// is required and no existing workspace changes behaviour on deploy.
model NotificationSettings {
  tenantId String @id

  /// Master switch. When false, no business event sends email at all,
  /// regardless of `emailEventTypes`. Transactional auth mail (invitations,
  /// password resets) is NOT governed by this — a workspace cannot switch off
  /// the mail that lets people into it.
  emailEnabled Boolean @default(true)

  /// Which NotificationType values also send email. Empty means "in-app only".
  /// Stored as strings rather than a Prisma enum for the same reason
  /// NotificationType is a TS const array: adding a type must not require a
  /// migration, and an unknown value here is inert rather than fatal.
  /// Json rather than a native array: MySQL (the Hostinger production target)
  /// has no array column type, so both providers store this as JSON and the
  /// application code has exactly one shape to deal with instead of two.
  emailEventTypes Json @default("[]")

  /// Which roles receive event email. A workspace can keep owners informed by
  /// mail while leaving staff on in-app only.
  emailRecipientRoles Json @default("[\"BUSINESS_OWNER\"]")

  /// Appointment reminders.
  appointmentRemindersEnabled    Boolean @default(true)
  /// Lead time in minutes. 1440 = one day before, which is the SRS's own example.
  appointmentReminderLeadMinutes Int     @default(1440)

  /// Follow-up on a sent quotation that nobody has responded to.
  quotationFollowUpEnabled Boolean @default(true)
  quotationFollowUpDays    Int     @default(3)

  /// Automatic expiry of quotations that were never answered. Distinct from the
  /// follow-up above: the follow-up nudges, this closes.
  quotationAutoExpireEnabled Boolean @default(false)
  quotationExpiryDays        Int     @default(30)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id
  email          String
  hashedPassword String
  firstName      String?
  lastName       String?
  phone          String?
  role           String // 'SUPER_ADMIN', 'BUSINESS_OWNER', 'STAFF'
  // Soft off-boarding. A hard delete is impossible: seven non-nullable columns
  // reference User (Quotation.createdByUserId, Appointment.assignedUserId,
  // Client.lastUpdatedByUserId, ...), so RESTRICT blocks it and cascading would
  // destroy financial and audit history. Same reasoning as ProductInUseError.
  isActive       Boolean  @default(true)
  // Platform Admin soft-delete. Set together with isActive=false, but distinct
  // from ordinary suspension: a deleted user's email/name/phone are also
  // anonymized (see DeleteUserUseCase), and there is no route back from this —
  // unlike suspension, which reactivation reverses. The row survives, never
  // hard-deleted, for the same seven-FK-RESTRICT reason isActive does.
  deletedAt      DateTime?
  // Interface language override. NULL means "follow the workspace default" —
  // distinct from having explicitly chosen English.
  language       String?
  // Profile media. Store the public URL of the canonical (1x) asset; the
  // responsive variants are derived from it by convention (see MediaService).
  avatarUrl      String?
  coverImageUrl  String?
  tenantId       String?
  createdAt      DateTime @default(now())

  tenant               Tenant?                  @relation(fields: [tenantId], references: [id])
  warehouseId          String?
  warehouse            Warehouse?               @relation("UserWarehouse", fields: [warehouseId], references: [id])
  passwordResetTokens  PasswordResetToken[]
  assignedClients      Client[]                 @relation("AssignedClients")
  updatedClients       Client[]                 @relation("LastUpdatedClients")
  interactions         Interaction[]
  assignedAppointments Appointment[]            @relation("AssignedAppointments")
  inventoryMovements   StockMovement[]
  quotations           Quotation[]
  statusChanges        QuotationStatusHistory[]
  invoices             Invoice[]
  invoiceStatusChanges InvoiceStatusHistory[]
  notifications        Notification[]           @relation("NotificationRecipient")
  causedNotifications  Notification[]           @relation("NotificationActor")
  sentInvitations      Invitation[]             @relation("InvitationSender")
  ownershipTransfersAsOriginalOwner OwnershipTransfer[] @relation("OwnershipTransferOriginalOwner")
  ownershipTransfersAsActingOwner   OwnershipTransfer[] @relation("OwnershipTransferActingOwner")
}

/// Records a temporary Business-Owner promotion created when a Platform Admin
/// suspends a Business Owner who still has active staff (see SuspendUserUseCase).
/// Reactivation reads the ACTIVE row to offer "restore original ownership",
/// "keep current ownership" or "keep both as Business Owners"
/// (PlatformReactivateUserUseCase), then resolves it to RESTORED, KEPT or
/// KEPT_BOTH — a terminal state, never reused. KEPT_BOTH demotes nobody: a
/// workspace may have any number of Business Owners.
///
/// Only created for suspension. A Business Owner deletion that transfers
/// ownership is permanent by construction (the original owner is gone), so it
/// has no row here — just an AuditLog entry.
model OwnershipTransfer {
  id                        String    @id
  tenantId                  String
  originalOwnerId           String
  actingOwnerId             String
  // The acting owner's role/warehouse before promotion, so "restore" can put
  // them back exactly where they were.
  previousActingRole        String
  previousActingWarehouseId String?
  status                    String    // 'ACTIVE' | 'RESTORED' | 'KEPT' | 'KEPT_BOTH'
  createdAt                 DateTime  @default(now())
  createdByUserId           String
  resolvedAt                DateTime?
  resolvedByUserId          String?

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  originalOwner User   @relation("OwnershipTransferOriginalOwner", fields: [originalOwnerId], references: [id])
  actingOwner   User   @relation("OwnershipTransferActingOwner", fields: [actingOwnerId], references: [id])

  @@index([originalOwnerId, status])
  @@index([actingOwnerId, status])
}

/// Append-only record of platform-administrative actions. Deliberately has no
/// foreign keys: an audit trail must survive the very rows it describes (a
/// soft-deleted user's history should not become unreadable), so actor/target
/// ids are plain strings rather than relations.
model AuditLog {
  id          String   @id
  actorUserId String
  actorRole   String
  action      String   // e.g. 'USER_SUSPENDED', 'USER_REACTIVATED', 'USER_DELETED', 'USER_INVITED', 'OWNERSHIP_TRANSFERRED'
  targetType  String   // 'USER'
  targetId    String
  tenantId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([tenantId])
}

model Invitation {
  id              String    @id
  tenantId        String
  email           String
  role            String
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  warehouseId     String?
  // Who sent it. Nullable because invitations predating this column exist and
  // cannot be attributed retroactively; new ones always carry a sender.
  invitedByUserId String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  warehouse Warehouse? @relation("InvitationWarehouse", fields: [warehouseId], references: [id])
  invitedBy User?      @relation("InvitationSender", fields: [invitedByUserId], references: [id])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Client {
  id                  String   @id
  tenantId            String
  name                String
  email               String?
  phone               String?
  status              String // 'PROSPECT', 'ACTIVE', 'INACTIVE'
  assignedUserId      String?
  customFieldValues   Json
  lastUpdatedByUserId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  assignedUser      User?         @relation("AssignedClients", fields: [assignedUserId], references: [id])
  lastUpdatedByUser User          @relation("LastUpdatedClients", fields: [lastUpdatedByUserId], references: [id])
  interactions      Interaction[]
  appointments      Appointment[]
  quotations        Quotation[]
  invoices          Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, name])
}

model CustomFieldDefinition {
  id        String   @id
  tenantId  String
  fieldName String
  // Stored as a plain String rather than a Postgres enum, so the authoritative
  // list is src/clients/domain/enums/FieldType.ts and adding a value needs no
  // migration. Currently: TEXT, NUMBER, DATE, BOOLEAN, SINGLE_SELECT.
  fieldType String
  // Json rather than a native array: MySQL (the Hostinger production target)
  // has no array column type, so both providers store this as JSON.
  options   Json @default("[]") // for SINGLE_SELECT

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, fieldName])
}

model OutcomeCategory {
  id       String @id
  tenantId String
  label    String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  interactions Interaction[]

  @@unique([tenantId, label])
}

model Interaction {
  id                String   @id
  tenantId          String
  clientId          String
  authorUserId      String
  content           String
  channel           String // 'MEETING', 'CALL', 'NOTE', 'EMAIL'
  outcomeCategoryId String?
  createdAt         DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id])
  authorUser      User             @relation(fields: [authorUserId], references: [id])
  outcomeCategory OutcomeCategory? @relation(fields: [outcomeCategoryId], references: [id])

  @@index([tenantId, clientId])
  @@index([tenantId, authorUserId])
}

model Appointment {
  id             String   @id
  tenantId       String
  clientId       String
  assignedUserId String
  scheduledAt    DateTime
  status         String // 'SCHEDULED', 'CONFIRMED', 'COMPLETED', 'CANCELLED'
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// When the pre-appointment reminder was sent. NULL means "not yet reminded".
  ///
  /// Set to NULL again by a reschedule: moving an appointment makes the old
  /// reminder describe a time that no longer exists, so the new time earns a
  /// new reminder. This is the whole dedup mechanism — the sweep selects on
  /// `remindedAt IS NULL`, so a reminder can never go twice for one time.
  remindedAt DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  assignedUser User                  @relation("AssignedAppointments", fields: [assignedUserId], references: [id])
  auditLogs    AppointmentAuditLog[]

  @@index([tenantId, scheduledAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, clientId])
  /// Drives the reminder sweep, which scans upcoming appointments by status and
  /// time across all tenants rather than within one.
  @@index([status, scheduledAt])
}

model AppointmentAuditLog {
  id            String   @id @default(uuid())
  appointmentId String
  previousDate  DateTime
  newDate       DateTime
  reason        String
  changedBy     String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

// ==========================================
// INVENTORY MODULE
// ==========================================

model Category {
  id          String   @id
  tenantId    String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
}

model Warehouse {
  id        String   @id
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  managers           User[]              @relation("UserWarehouse")
  invitations        Invitation[]        @relation("InvitationWarehouse")
  stockLevels        StockLevel[]
  movements          StockMovement[]     @relation("AdjustmentWarehouse")
  movementsFrom      StockMovement[]     @relation("FromWarehouse")
  movementsTo        StockMovement[]     @relation("ToWarehouse")
  quotationLineItems QuotationLineItem[]
  invoiceLineItems   InvoiceLineItem[]

  @@unique([tenantId, name])
}

model Product {
  id                String   @id
  tenantId          String
  name              String
  description       String
  sku               String?
  brand             String?
  categoryId        String?
  price             Float
  // Unit cost. Nullable because a catalogue can be priced before it is costed.
  cost              Float?
  // Json rather than a native array: MySQL (the Hostinger production target)
  // has no array column type, so both providers store this as JSON.
  tags              Json     @default("[]")
  lowStockThreshold Int      @default(10)
  // Archived products stay queryable (quotations reference them) but drop out
  // of the default catalogue view. Availability is always derived from stock.
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  stockLevels        StockLevel[]
  movements          StockMovement[]
  images             ProductImage[]
  quotationLineItems QuotationLineItem[]
  invoiceLineItems   InvoiceLineItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([tenantId, isArchived])
}

model ProductImage {
  id        String   @id
  tenantId  String
  productId String
  // Public URL of the @1x rendition; @2x is derived by naming convention.
  url       String
  url2x     String
  width     Int
  height    Int
  bytes     Int
  // Zero-based gallery order. Position 0 is the product's primary image.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, position])
}

model StockLevel {
  id                String @id
  tenantId          String
  productId         String
  productTenantId   String
  warehouseId       String
  warehouseTenantId String
  quantity          Int

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, productId, warehouseId])
}

model StockMovement {
  id              String   @id
  tenantId        String
  productId       String
  warehouseId     String? // Used for ADJUSTMENT
  fromWarehouseId String? // Used for TRANSFER
  toWarehouseId   String? // Used for TRANSFER
  quantity        Int
  type            String // 'ADJUSTMENT', 'TRANSFER'
  reason          String?
  createdBy       String
  createdAt       DateTime @default(now())

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])
  warehouse     Warehouse? @relation("AdjustmentWarehouse", fields: [warehouseId], references: [id])
  fromWarehouse Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  authorUser    User       @relation(fields: [createdBy], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, fromWarehouseId])
  @@index([tenantId, toWarehouseId])
  @@index([tenantId, createdAt])
}

// ==========================================
// QUOTATIONS MODULE
// ==========================================

model Quotation {
  id              String    @id @default(uuid())
  tenantId        String
  clientId        String
  createdByUserId String
  status          String
  sentAt          DateTime?
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Unguessable capability token for the customer-facing view.
  ///
  /// Issued when the quotation first reaches SENT and never reissued, so the
  /// link in a customer's inbox keeps working. NULL for everything that has not
  /// been sent — which is what makes an unsent quotation unreachable rather
  /// than merely unadvertised.
  ///
  /// Globally unique rather than unique-per-tenant on purpose: the public route
  /// has no tenant context to scope by, so the token IS the lookup key.
  shareToken         String?   @unique
  shareTokenIssuedAt DateTime?

  /// When the unanswered-quotation follow-up was sent. NULL means "not yet
  /// chased". A column rather than a query over Notification because the
  /// notification table is pruned on a retention policy and a chase must never
  /// repeat because its record aged out.
  followUpSentAt DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  client    Client @relation(fields: [clientId], references: [id])
  createdBy User   @relation(fields: [createdByUserId], references: [id])

  lineItems     QuotationLineItem[]
  statusHistory QuotationStatusHistory[]

  /// At most one — converting a second time is refused by
  /// ConvertQuotationToInvoiceUseCase and, decisively, by Invoice.quotationId
  /// being @unique. No `@relation` needed on this side beyond the implicit
  /// back-reference: Prisma infers the one-to-one from Invoice's unique FK.
  invoice Invoice?

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  /// Drives the follow-up and auto-expiry sweeps, which both scan SENT
  /// quotations by age across all tenants.
  @@index([status, sentAt])
}

model QuotationLineItem {
  id          String @id @default(uuid())
  tenantId    String
  quotationId String
  productId   String
  warehouseId String
  quantity    Int
  unitPrice   Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, quotationId])
}

model QuotationStatusHistory {
  id              String   @id @default(uuid())
  tenantId        String
  quotationId     String
  fromStatus      String
  toStatus        String

  /// NULL means the scheduler made this change, not a person.
  ///
  /// Automatic expiry has no acting user, and the two available alternatives
  /// were both worse: attributing it to the quotation's creator would put a
  /// change in the audit trail under the name of someone who did not make it,
  /// and inventing a "system" User row would put a login-shaped record in a
  /// table where every other row can authenticate. NULL says exactly what
  /// happened.
  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict` is stated explicitly, not left to the default.
  ///
  /// Making this relation optional flipped Prisma's implicit default from
  /// RESTRICT to SET NULL — which would mean deleting a User silently rewrote
  /// their past status changes as "done by the scheduler". NULL here has one
  /// meaning and it is not "we lost the name". Deleting a user with history
  /// stays blocked; off-boarding is `User.isActive`, as it already was.
  changedBy User?     @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, quotationId])
}

// ==========================================
// INVOICES MODULE
// ==========================================

model Invoice {
  id              String    @id @default(uuid())
  tenantId        String
  clientId        String

  /// Created by converting exactly one ACCEPTED Quotation — enforced by this
  /// unique constraint, the actual guarantee under concurrency (the use case's
  /// own "does one already exist" check is a defensive, non-atomic mirror of
  /// this).
  quotationId     String    @unique
  createdByUserId String
  status          String
  dueDate         DateTime
  sentAt          DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])
  createdBy User      @relation(fields: [createdByUserId], references: [id])

  lineItems     InvoiceLineItem[]
  statusHistory InvoiceStatusHistory[]

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  /// Drives the overdue sweep (InvoiceOverdueJob), which scans SENT invoices
  /// by due date across all tenants — same shape as Quotation's
  /// `[status, sentAt]` index for the same reason.
  @@index([status, dueDate])
}

model InvoiceLineItem {
  id        String @id @default(uuid())
  tenantId  String
  invoiceId String

  /// Copied from the source QuotationLineItem at conversion time — a
  /// snapshot, not a live reference. A quotation edited after conversion must
  /// not retroactively change an issued invoice.
  productId   String
  warehouseId String
  quantity    Int
  unitPrice   Float

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, invoiceId])
}

model InvoiceStatusHistory {
  id         String   @id @default(uuid())
  tenantId   String
  invoiceId  String
  fromStatus String
  toStatus   String

  /// NULL means the scheduler made this change, not a person — same
  /// convention as QuotationStatusHistory.changedByUserId, for the same
  /// reason: automatic overdue detection has no acting user.
  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict`, stated explicitly — same rationale as
  /// QuotationStatusHistory.changedBy: deleting a user must not silently
  /// rewrite their past status changes as "done by the scheduler".
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
}

// ==========================================
// SETTINGS / INTEGRATIONS MODULE
// ==========================================

model Integration {
  id        String   @id
  tenantId  String
  provider  String // e.g., 'GOOGLE_CALENDAR'
  status    String // 'CONNECTED', 'DISCONNECTED'
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
}

/// In-app notification, one row per recipient.
///
/// `type` is an i18n KEY and `params` its interpolation values — never a
/// rendered sentence. Notifications are read days after they are written and
/// outlive any single session, so a stored English string would be permanently
/// wrong for an Albanian reader (the problem TD-016 describes for error
/// messages, but far more visible and durable here).
///
/// Within `params`, entity labels are SNAPSHOTS (the client name as it was when
/// the event happened, which is what the notification is describing) while
/// people are referenced BY ID and resolved at render time (a colleague's name
/// should read as it is now).
model Notification {
  id              String @id @default(uuid())
  tenantId        String
  recipientUserId String

  type   String
  params Json

  /// Null for system-originated events, e.g. expiry.
  actorUserId String?

  /// Deep-link target: QUOTATION | APPOINTMENT | CLIENT.
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  actor     User?  @relation("NotificationActor", fields: [actorUserId], references: [id])

  /// Serves both the unread badge and the list, which are always scoped to one
  /// recipient within one tenant and ordered newest-first.
  @@index([tenantId, recipientUserId, readAt, createdAt])
  /// Retention pruning scans by age.
  @@index([tenantId, createdAt])
}
