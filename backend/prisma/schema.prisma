/**
 * PostgreSQL is the active schema, and the one `prisma/migrations` is written
 * for — every migration in that folder emits `TIMESTAMP(3)`, `JSONB` and
 * double-quoted identifiers, so `prisma migrate deploy` only ever worked here.
 * `schema.mysql.prisma` beside this file is the hand-maintained MySQL mirror
 * used by the Hostinger deployment, which is provisioned from
 * `nevacrm_full_import.sql` rather than from the migration history. The two
 * now differ ONLY in the `@db.Text` annotations MySQL needs for long strings —
 * the four array-shaped columns (tags, options, emailEventTypes,
 * emailRecipientRoles) are `Json` on both sides on purpose, so the
 * application code has exactly one shape to handle instead of branching per
 * provider. Any model change must be made in both, or the deployment drifts
 * from what the code expects.
 */
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Whether a workspace is allowed to operate.
///
/// This is the first Prisma-level enum in the schema — `UserRole` and the
/// various status fields are TypeScript enums over String columns. The
/// difference is deliberate: this value is closed, platform-controlled and
/// never user-supplied, and it gates login for an entire workspace. A bad
/// value here silently locks out or lets in a whole tenant, so the constraint
/// is worth having in the database rather than only in application code.
///
/// SUSPENDED retains all data. There is no value here meaning "deleted" —
/// hard deletion is deliberately not a thing this model can express.
enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                        String  @id
  name                      String
  urlSlug                   String  @unique
  requiresQuotationApproval Boolean @default(true)
  // Workspace branding, surfaced in the sidebar, settings and customer-facing pages.
  logoUrl                   String?
  coverImageUrl             String?

  // Company profile. Like the branding URLs above, these are presentation-only
  // and are read straight from Prisma rather than through the Tenant entity.
  registrationNumber String?
  addressLine        String?
  addressCity        String?
  addressState       String?
  addressPostalCode  String?
  contactEmail       String?
  contactPhone       String?

  // Localization. Unlike the fields above these drive real behaviour (money
  // formatting, and notifications later), so they DO live on the domain entity.
  // NOT NULL with defaults so the fallback lives here and nowhere else.
  currency   String @default("USD")
  locale     String @default("en-US")
  timezone   String @default("UTC")
  dateFormat String @default("MM/DD/YYYY")

  // Interface language for the workspace. Separate from `locale` above by
  // design: locale is how things are FORMATTED, this is what language they are
  // WRITTEN in. Also the only language source available for invitation emails,
  // whose recipients have no account yet.
  defaultLanguage String @default("en")

  // Whether the workspace may operate at all. Like the localization fields
  // above this drives real behaviour — it gates login and every tenant-scoped
  // request — so it lives on the domain entity too.
  //
  // Defaulting to ACTIVE is what makes the migration safe: every tenant that
  // exists today is by definition operating, and a nullable or SUSPENDED
  // default would either introduce a third "unknown" state for every read site
  // to handle or lock out live customers on deploy.
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  // Stamped the first (and only) time EnsureDefaultClientFieldsUseCase seeds
  // this tenant's baseline client fields (Name/Email/Phone/Status/Assigned To).
  // The seeder used to decide by "which FieldRoles are missing", which meant a
  // business owner could never delete one of those fields: the next read of
  // the field list silently recreated it at the bottom of the order. This
  // stamp makes seeding a one-time event, so deletes stick.
  clientFieldsSeededAt DateTime?

  // Same one-shot reasoning as clientFieldsSeededAt, for the starter intake
  // form built from those fields (EnsureDefaultClientFormUseCase). Without the
  // stamp, "create the default form if the tenant has none" would resurrect a
  // form the owner deliberately deleted on the very next page load.
  clientFormSeededAt DateTime?

  createdAt DateTime @default(now())

  users                  User[]
  ownershipTransfers     OwnershipTransfer[]
  invitations            Invitation[]
  clients                Client[]
  customFieldDefinitions CustomFieldDefinition[]
  clientForms            ClientForm[]
  formVersions           FormVersion[]
  formSubmissions        FormSubmission[]
  outcomeCategories      OutcomeCategory[]
  interactions           Interaction[]
  appointments           Appointment[]

  // Inventory
  categories     Category[]
  warehouses     Warehouse[]
  products       Product[]
  productImages  ProductImage[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  // Quotations
  quotations Quotation[]

  // Invoices
  invoices Invoice[]

  // Contracts
  contracts Contract[]

  notifications        Notification[]
  notificationSettings NotificationSettings?

  // Integrations
  integrations Integration[]

  // Slice 3: RBAC
  roles Role[]

  // Slice 8: lookup lists
  riskLevels    RiskLevel[]
  businessTypes BusinessType[]

  // Slice 9: areas and cities
  areas  Area[]
  cities City[]

  // Slice 10: sales lists
  followUpIntervals FollowUpInterval[]
  lostReasons       LostReason[]

  // Slice 10: status labels
  statusLabels StatusLabel[]
}

/// Platform-wide default settings, applied to a workspace only at the moment
/// it is PROVISIONED — never retroactively to an existing tenant. See
/// EnterTenantUseCase's sibling, CreateTenantWithOwnerUseCase, which reads this
/// row (falling back to PlatformSettings.defaults() if it has never been saved)
/// when building a new Tenant.
///
/// Deliberately NOT a live default that existing tenants keep following: a
/// workspace's own settings, once created, are that workspace's property, and
/// changing this row must never silently move a paying customer's currency or
/// timezone out from under them. Reaching an existing tenant is a separate,
/// explicit action — the platform console's per-tenant bulk apply — not a side
/// effect of editing this row.
///
/// A genuine singleton: exactly one row, `id` fixed at 'platform' by
/// convention (see PrismaPlatformSettingsRepository) rather than modelled with
/// no primary key at all, so `upsert` has a stable target.
model PlatformSettings {
  id                        String   @id @default("platform")
  requiresQuotationApproval Boolean  @default(true)
  currency                  String   @default("USD")
  locale                    String   @default("en-US")
  timezone                  String   @default("UTC")
  dateFormat                String   @default("MM/DD/YYYY")
  defaultLanguage           String   @default("en")
  updatedAt                 DateTime @updatedAt
}

/// Per-workspace notification policy.
///
/// §6.6 of the SRS makes every notification behaviour configurable per
/// business: which events fire, who receives email, how far ahead a reminder
/// goes out, how long to wait before chasing a quotation. All of that lives
/// here, in one row per tenant, rather than as a scatter of booleans on Tenant.
///
/// The row is OPTIONAL. A tenant with no row gets `NotificationSettings.defaults()`
/// — see the domain entity. That is what makes this migration safe: no backfill
/// is required and no existing workspace changes behaviour on deploy.
model NotificationSettings {
  tenantId String @id

  /// Master switch. When false, no business event sends email at all,
  /// regardless of `emailEventTypes`. Transactional auth mail (invitations,
  /// password resets) is NOT governed by this — a workspace cannot switch off
  /// the mail that lets people into it.
  emailEnabled Boolean @default(true)

  /// Which NotificationType values also send email. Empty means "in-app only".
  /// Stored as strings rather than a Prisma enum for the same reason
  /// NotificationType is a TS const array: adding a type must not require a
  /// migration, and an unknown value here is inert rather than fatal.
  /// Json rather than a native array: MySQL (the Hostinger production target)
  /// has no array column type, so both providers store this as JSON and the
  /// application code has exactly one shape to deal with instead of two.
  emailEventTypes Json @default("[]")

  /// Which roles receive event email. A workspace can keep owners informed by
  /// mail while leaving staff on in-app only.
  emailRecipientRoles Json @default("[\"BUSINESS_OWNER\"]")

  /// Appointment reminders.
  appointmentRemindersEnabled    Boolean @default(true)
  /// Lead time in minutes. 1440 = one day before, which is the SRS's own example.
  appointmentReminderLeadMinutes Int     @default(1440)

  /// Follow-up on a sent quotation that nobody has responded to.
  quotationFollowUpEnabled Boolean @default(true)
  quotationFollowUpDays    Int     @default(3)

  /// Automatic expiry of quotations that were never answered. Distinct from the
  /// follow-up above: the follow-up nudges, this closes.
  quotationAutoExpireEnabled Boolean @default(false)
  quotationExpiryDays        Int     @default(30)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id
  email          String
  hashedPassword String
  firstName      String?
  lastName       String?
  phone          String?
  role           String // 'SUPER_ADMIN', 'BUSINESS_OWNER', 'STAFF'
  // Slice 3: the permission-bearing role. NULL for every user created before
  // this migration and for SUPER_ADMIN, which sits outside the role table
  // (D2 in the Milestone 1 plan) — ResolveAccessContextUseCase falls back to
  // LegacyRoleMapping (keyed on `role` above) whenever this is NULL, so the
  // rollback path (dropping this column) stays safe. `role` itself is kept,
  // unchanged, for that same rollback and because SUPER_ADMIN has no row here.
  roleId         String?
  // Soft off-boarding. A hard delete is impossible: seven non-nullable columns
  // reference User (Quotation.createdByUserId, Appointment.assignedUserId,
  // Client.lastUpdatedByUserId, ...), so RESTRICT blocks it and cascading would
  // destroy financial and audit history. Same reasoning as ProductInUseError.
  isActive       Boolean   @default(true)
  // Platform Admin soft-delete. Set together with isActive=false, but distinct
  // from ordinary suspension: a deleted user's email/name/phone are also
  // anonymized (see DeleteUserUseCase), and there is no route back from this —
  // unlike suspension, which reactivation reverses. The row survives, never
  // hard-deleted, for the same seven-FK-RESTRICT reason isActive does.
  deletedAt      DateTime?
  // Interface language override. NULL means "follow the workspace default" —
  // distinct from having explicitly chosen English.
  language       String?
  // Profile media. Store the public URL of the canonical (1x) asset; the
  // responsive variants are derived from it by convention (see MediaService).
  avatarUrl      String?
  coverImageUrl  String?
  tenantId       String?
  createdAt      DateTime  @default(now())

  tenant                            Tenant?                  @relation(fields: [tenantId], references: [id])
  warehouseId                       String?
  warehouse                         Warehouse?               @relation("UserWarehouse", fields: [warehouseId], references: [id])
  passwordResetTokens               PasswordResetToken[]
  assignedClients                   Client[]                 @relation("AssignedClients")
  updatedClients                    Client[]                 @relation("LastUpdatedClients")
  interactions                      Interaction[]
  assignedAppointments              Appointment[]            @relation("AssignedAppointments")
  inventoryMovements                StockMovement[]
  quotations                        Quotation[]
  statusChanges                     QuotationStatusHistory[]
  invoices                          Invoice[]
  invoiceStatusChanges              InvoiceStatusHistory[]
  assignedContracts                 Contract[]               @relation("AssignedContracts")
  createdContracts                  Contract[]               @relation("CreatedContracts")
  contractStatusChanges             ContractStatusHistory[]  @relation("ContractStatusChanges")
  notifications                     Notification[]           @relation("NotificationRecipient")
  causedNotifications               Notification[]           @relation("NotificationActor")
  sentInvitations                   Invitation[]             @relation("InvitationSender")
  ownershipTransfersAsOriginalOwner OwnershipTransfer[]      @relation("OwnershipTransferOriginalOwner")
  ownershipTransfersAsActingOwner   OwnershipTransfer[]      @relation("OwnershipTransferActingOwner")

  assignedRole Role? @relation(fields: [roleId], references: [id])

  @@index([roleId])
}

/// Slice 3 (FR-RBAC-01, 02): one of a tenant's five system roles, or a custom
/// role created by copying one (FR-RBAC-04, Slice 6). A role IS a set of
/// permissions — the permissions themselves are `RolePermission` rows, never
/// hard-coded per role name, so granting or revoking one needs no deployment
/// (FR-RBAC-02's acceptance criterion). `key` is the stable identifier code
/// checks against (`SALES_USER`, `SALES_MANAGER`, `RECEPTION`,
/// `ADMINISTRATOR`, `CEO` for system roles); `nameSq`/`nameEn` are what the
/// Roles admin screen (Slice 6) shows. `isSystem` roles cannot be deleted and
/// their `key` cannot change, but their permissions can (FR-RBAC-03).
model Role {
  id        String   @id
  tenantId  String
  key       String
  nameSq    String
  nameEn    String
  isSystem  Boolean  @default(false)
  /// For a custom role (Slice 6, FR-RBAC-04): the system role key it was
  /// copied from, directly or through another copy. NULL for a system role.
  /// Team scope and the legacy `User.role` string follow this lineage.
  baseKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// One permission grant on a `Role` (FR-RBAC-02). `permissionKey` is a key
/// from the in-code `PermissionCatalogue` (`src/access/domain`), never
/// validated by a foreign key — the catalogue is code, not data, per
/// FR-RBAC-02. `scope` is OWN/TEAM/ALL for a scoped permission
/// (`PermissionCatalogue` entries marked `supportsScope`), and NULL for a
/// plain capability (e.g. `users.manage`), where holding the row at all is
/// the grant.
model RolePermission {
  roleId        String
  permissionKey String
  scope         String?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

/// Records a temporary Business-Owner promotion created when a Platform Admin
/// suspends a Business Owner who still has active staff (see SuspendUserUseCase).
/// Reactivation reads the ACTIVE row to offer "restore original ownership",
/// "keep current ownership" or "keep both as Business Owners"
/// (PlatformReactivateUserUseCase), then resolves it to RESTORED, KEPT or
/// KEPT_BOTH — a terminal state, never reused. KEPT_BOTH demotes nobody: a
/// workspace may have any number of Business Owners.
///
/// Only created for suspension. A Business Owner deletion that transfers
/// ownership is permanent by construction (the original owner is gone), so it
/// has no row here — just an AuditLog entry.
model OwnershipTransfer {
  id                        String    @id
  tenantId                  String
  originalOwnerId           String
  actingOwnerId             String
  // The acting owner's role/warehouse before promotion, so "restore" can put
  // them back exactly where they were.
  previousActingRole        String
  previousActingWarehouseId String?
  status                    String // 'ACTIVE' | 'RESTORED' | 'KEPT' | 'KEPT_BOTH'
  createdAt                 DateTime  @default(now())
  createdByUserId           String
  resolvedAt                DateTime?
  resolvedByUserId          String?

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  originalOwner User   @relation("OwnershipTransferOriginalOwner", fields: [originalOwnerId], references: [id])
  actingOwner   User   @relation("OwnershipTransferActingOwner", fields: [actingOwnerId], references: [id])

  @@index([originalOwnerId, status])
  @@index([actingOwnerId, status])
}

/// Append-only record of platform-administrative actions. Deliberately has no
/// foreign keys: an audit trail must survive the very rows it describes (a
/// soft-deleted user's history should not become unreadable), so actor/target
/// ids are plain strings rather than relations.
model AuditLog {
  id          String   @id
  actorUserId String
  actorRole   String
  action      String // e.g. 'USER_SUSPENDED', 'USER_REACTIVATED', 'USER_DELETED', 'USER_INVITED', 'OWNERSHIP_TRANSFERRED'
  targetType  String // 'USER'
  targetId    String
  tenantId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([tenantId])
}

/// Append-only, tenant-scoped compliance trail (Slice 2: FR-AUD-01). Every
/// sensitive write in a tenant's workspace — contracts, payments, users,
/// roles, settings — lands here as one row with the field-level old and new
/// values, written in the same transaction as the change (FR-AUD-04). No
/// foreign keys, for the same reason as `AuditLog`: the trail must outlive
/// the rows it describes. Distinct from `AuditLog`, which stays the record of
/// platform-operator actions (D5 in the Milestone 1 plan).
model AuditEntry {
  id       String   @id
  tenantId String
  at       DateTime @default(now())

  /// NULL means a system actor (the scheduler), not a person — `userRole` is
  /// then `'SYSTEM'`. See `SYSTEM_ACTOR` in `src/audit/domain/AuditEntry.ts`.
  userId   String?
  userRole String

  /// CREATE | UPDATE | DELETE | STATUS_CHANGE — see AuditAction in
  /// src/audit/domain/AuditAction.ts. A String column for the same reason
  /// every other status here is one.
  action String

  entityType  String
  entityId    String
  entityLabel String?

  /// AuditChange[] — [{field, old, new}], JSON-safe and already redacted for
  /// secret fields by `diff()` before it ever reaches this column.
  changes Json

  @@index([tenantId, at])
  @@index([tenantId, entityType, entityId])
}

model Invitation {
  id              String    @id
  // Nullable: a Platform Admin invitation belongs to no workspace.
  tenantId        String?
  email           String
  role            String
  // The role the account is created with (Slice 5). Null only for a Platform
  // Admin invitation, which has no workspace and so no role table.
  roleId          String?
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  warehouseId     String?
  // Who sent it. Nullable because invitations predating this column exist and
  // cannot be attributed retroactively; new ones always carry a sender.
  invitedByUserId String?

  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  warehouse    Warehouse? @relation("InvitationWarehouse", fields: [warehouseId], references: [id])
  invitedBy    User?      @relation("InvitationSender", fields: [invitedByUserId], references: [id])
  assignedRole Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([roleId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Client {
  // name/email/phone/status/assignedUserId are being dissolved into the
  // tenant-editable CustomFieldDefinition system (see FieldRole) so a
  // business owner can rename/retype/delete/reorder every client field,
  // including these. Kept nullable here during the transition: existing
  // rows/tooling can still read them, but customFieldValues is the
  // authoritative source going forward — see ClientFieldResolver.
  id                  String    @id
  tenantId            String
  name                String?
  email               String?
  phone               String?
  status              String? // legacy: 'PROSPECT', 'ACTIVE', 'INACTIVE'
  assignedUserId      String?
  customFieldValues   Json
  /// Free-text internal notes about the client, private to the workspace.
  /// A dedicated column rather than an entry in customFieldValues: those are
  /// tenant-defined and validated against the tenant's live definitions, and a
  /// tenant that deleted the definition would lose the notes with it. This is
  /// a system field, always present, never renameable.
  notes               String?
  lastUpdatedByUserId String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Soft delete, same reasoning as User.deletedAt above. A hard delete is
  // impossible here too: Interaction/Appointment/Quotation/Invoice each hold a
  // non-nullable clientId with no cascade rule, so RESTRICT blocks removing any
  // client who has ever been booked or invoiced — and cascading would destroy
  // issued invoices, rewriting historical revenue. NULL means active; every
  // client-facing read filters on it. Reversible, unlike User.deletedAt.
  deletedAt           DateTime?

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  assignedUser      User?         @relation("AssignedClients", fields: [assignedUserId], references: [id])
  lastUpdatedByUser User          @relation("LastUpdatedClients", fields: [lastUpdatedByUserId], references: [id])
  interactions      Interaction[]
  appointments      Appointment[]
  quotations        Quotation[]
  invoices          Invoice[]
  contracts         Contract[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, name])
}

model CustomFieldDefinition {
  id        String  @id
  tenantId  String
  fieldName String
  // Stored as a plain String rather than a Postgres enum, so the authoritative
  // list is src/clients/domain/enums/FieldType.ts and adding a value needs no
  // migration. Currently: TEXT, NUMBER, DATE, BOOLEAN, ALPHANUMERIC, LONG_TEXT,
  // SINGLE_SELECT, MULTI_SELECT, EMAIL, USER_REFERENCE.
  fieldType String
  // Json rather than a native array: MySQL (the Hostinger production target)
  // has no array column type, so both providers store this as JSON.
  options   Json    @default("[]") // for SINGLE_SELECT
  // Display order within the tenant's field list (client form/detail/settings).
  order     Int     @default(0)
  // Tags this field as the tenant's designated field for a system concern
  // (search/PDFs/email delivery/reports/dashboard scoping) — see
  // src/clients/domain/enums/FieldRole.ts and ClientFieldResolver. Plain
  // String for the same reason fieldType is. At most one field per
  // (tenantId, role); NULL is distinct per row in both Postgres and MySQL
  // so unroled fields are unaffected.
  role      String?
  required  Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, fieldName])
  @@unique([tenantId, role])
}

model OutcomeCategory {
  id       String @id
  tenantId String
  label    String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  interactions Interaction[]

  @@unique([tenantId, label])
}

model Interaction {
  id                String   @id
  tenantId          String
  clientId          String
  authorUserId      String
  content           String
  channel           String // 'MEETING', 'CALL', 'NOTE', 'EMAIL'
  outcomeCategoryId String?
  createdAt         DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id])
  authorUser      User             @relation(fields: [authorUserId], references: [id])
  outcomeCategory OutcomeCategory? @relation(fields: [outcomeCategoryId], references: [id])

  @@index([tenantId, clientId])
  @@index([tenantId, authorUserId])
}

model Appointment {
  id             String   @id
  tenantId       String
  clientId       String
  assignedUserId String
  scheduledAt    DateTime
  status         String // 'SCHEDULED', 'CONFIRMED', 'COMPLETED', 'CANCELLED'
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// When the pre-appointment reminder was sent. NULL means "not yet reminded".
  ///
  /// Set to NULL again by a reschedule: moving an appointment makes the old
  /// reminder describe a time that no longer exists, so the new time earns a
  /// new reminder. This is the whole dedup mechanism — the sweep selects on
  /// `remindedAt IS NULL`, so a reminder can never go twice for one time.
  remindedAt DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  assignedUser User                  @relation("AssignedAppointments", fields: [assignedUserId], references: [id])
  auditLogs    AppointmentAuditLog[]

  @@index([tenantId, scheduledAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, clientId])
  /// Drives the reminder sweep, which scans upcoming appointments by status and
  /// time across all tenants rather than within one.
  @@index([status, scheduledAt])
}

model AppointmentAuditLog {
  id            String   @id @default(uuid())
  appointmentId String
  previousDate  DateTime
  newDate       DateTime
  reason        String
  changedBy     String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

// ==========================================
// INVENTORY MODULE
// ==========================================

model Category {
  id          String   @id
  tenantId    String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
}

model Warehouse {
  id        String   @id
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  managers           User[]              @relation("UserWarehouse")
  invitations        Invitation[]        @relation("InvitationWarehouse")
  stockLevels        StockLevel[]
  movements          StockMovement[]     @relation("AdjustmentWarehouse")
  movementsFrom      StockMovement[]     @relation("FromWarehouse")
  movementsTo        StockMovement[]     @relation("ToWarehouse")
  quotationLineItems QuotationLineItem[]
  invoiceLineItems   InvoiceLineItem[]

  @@unique([tenantId, name])
}

model Product {
  id                String   @id
  tenantId          String
  name              String
  description       String
  sku               String?
  brand             String?
  categoryId        String?
  price             Float
  // Unit cost. Nullable because a catalogue can be priced before it is costed.
  cost              Float?
  // Json rather than a native array: MySQL (the Hostinger production target)
  // has no array column type, so both providers store this as JSON.
  tags              Json     @default("[]")
  lowStockThreshold Int      @default(10)
  // Archived products stay queryable (quotations reference them) but drop out
  // of the default catalogue view. Availability is always derived from stock.
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  stockLevels        StockLevel[]
  movements          StockMovement[]
  images             ProductImage[]
  quotationLineItems QuotationLineItem[]
  invoiceLineItems   InvoiceLineItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([tenantId, isArchived])
}

model ProductImage {
  id        String   @id
  tenantId  String
  productId String
  // Public URL of the @1x rendition; @2x is derived by naming convention.
  url       String
  url2x     String
  width     Int
  height    Int
  bytes     Int
  // Zero-based gallery order. Position 0 is the product's primary image.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, position])
}

model StockLevel {
  id                String @id
  tenantId          String
  productId         String
  productTenantId   String
  warehouseId       String
  warehouseTenantId String
  quantity          Int

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, productId, warehouseId])
}

model StockMovement {
  id              String   @id
  tenantId        String
  productId       String
  warehouseId     String? // Used for ADJUSTMENT
  fromWarehouseId String? // Used for TRANSFER
  toWarehouseId   String? // Used for TRANSFER
  quantity        Int
  type            String // 'ADJUSTMENT', 'TRANSFER'
  reason          String?
  createdBy       String
  createdAt       DateTime @default(now())

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])
  warehouse     Warehouse? @relation("AdjustmentWarehouse", fields: [warehouseId], references: [id])
  fromWarehouse Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  authorUser    User       @relation(fields: [createdBy], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, fromWarehouseId])
  @@index([tenantId, toWarehouseId])
  @@index([tenantId, createdAt])
}

// ==========================================
// QUOTATIONS MODULE
// ==========================================

model Quotation {
  id              String    @id @default(uuid())
  tenantId        String
  clientId        String
  createdByUserId String
  status          String
  sentAt          DateTime?
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Unguessable capability token for the customer-facing view.
  ///
  /// Issued when the quotation first reaches SENT and never reissued, so the
  /// link in a customer's inbox keeps working. NULL for everything that has not
  /// been sent — which is what makes an unsent quotation unreachable rather
  /// than merely unadvertised.
  ///
  /// Globally unique rather than unique-per-tenant on purpose: the public route
  /// has no tenant context to scope by, so the token IS the lookup key.
  shareToken         String?   @unique
  shareTokenIssuedAt DateTime?

  /// When the unanswered-quotation follow-up was sent. NULL means "not yet
  /// chased". A column rather than a query over Notification because the
  /// notification table is pruned on a retention policy and a chase must never
  /// repeat because its record aged out.
  followUpSentAt DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  client    Client @relation(fields: [clientId], references: [id])
  createdBy User   @relation(fields: [createdByUserId], references: [id])

  lineItems     QuotationLineItem[]
  statusHistory QuotationStatusHistory[]

  /// At most one — converting a second time is refused by
  /// ConvertQuotationToInvoiceUseCase and, decisively, by Invoice.quotationId
  /// being @unique. No `@relation` needed on this side beyond the implicit
  /// back-reference: Prisma infers the one-to-one from Invoice's unique FK.
  invoice Invoice?

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  /// Drives the follow-up and auto-expiry sweeps, which both scan SENT
  /// quotations by age across all tenants.
  @@index([status, sentAt])
}

model QuotationLineItem {
  id          String @id @default(uuid())
  tenantId    String
  quotationId String
  productId   String
  warehouseId String
  quantity    Int
  unitPrice   Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, quotationId])
}

model QuotationStatusHistory {
  id          String @id @default(uuid())
  tenantId    String
  quotationId String
  fromStatus  String
  toStatus    String

  /// NULL means the scheduler made this change, not a person.
  ///
  /// Automatic expiry has no acting user, and the two available alternatives
  /// were both worse: attributing it to the quotation's creator would put a
  /// change in the audit trail under the name of someone who did not make it,
  /// and inventing a "system" User row would put a login-shaped record in a
  /// table where every other row can authenticate. NULL says exactly what
  /// happened.
  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict` is stated explicitly, not left to the default.
  ///
  /// Making this relation optional flipped Prisma's implicit default from
  /// RESTRICT to SET NULL — which would mean deleting a User silently rewrote
  /// their past status changes as "done by the scheduler". NULL here has one
  /// meaning and it is not "we lost the name". Deleting a user with history
  /// stays blocked; off-boarding is `User.isActive`, as it already was.
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, quotationId])
}

// ==========================================
// INVOICES MODULE
// ==========================================

model Invoice {
  id       String @id @default(uuid())
  tenantId String
  clientId String

  /// Created by converting exactly one ACCEPTED Quotation — enforced by this
  /// unique constraint, the actual guarantee under concurrency (the use case's
  /// own "does one already exist" check is a defensive, non-atomic mirror of
  /// this).
  quotationId     String    @unique
  createdByUserId String
  status          String
  dueDate         DateTime
  sentAt          DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])
  createdBy User      @relation(fields: [createdByUserId], references: [id])

  lineItems     InvoiceLineItem[]
  statusHistory InvoiceStatusHistory[]

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  /// Drives the overdue sweep (InvoiceOverdueJob), which scans SENT invoices
  /// by due date across all tenants — same shape as Quotation's
  /// `[status, sentAt]` index for the same reason.
  @@index([status, dueDate])
}

model InvoiceLineItem {
  id        String @id @default(uuid())
  tenantId  String
  invoiceId String

  /// Copied from the source QuotationLineItem at conversion time — a
  /// snapshot, not a live reference. A quotation edited after conversion must
  /// not retroactively change an issued invoice.
  productId   String
  warehouseId String
  quantity    Int
  unitPrice   Float

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, invoiceId])
}

model InvoiceStatusHistory {
  id         String @id @default(uuid())
  tenantId   String
  invoiceId  String
  fromStatus String
  toStatus   String

  /// NULL means the scheduler made this change, not a person — same
  /// convention as QuotationStatusHistory.changedByUserId, for the same
  /// reason: automatic overdue detection has no acting user.
  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict`, stated explicitly — same rationale as
  /// QuotationStatusHistory.changedBy: deleting a user must not silently
  /// rewrite their past status changes as "done by the scheduler".
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
}

// ==========================================
// SETTINGS / INTEGRATIONS MODULE
// ==========================================

model Integration {
  id        String   @id
  tenantId  String
  provider  String // e.g., 'GOOGLE_CALENDAR'
  status    String // 'CONNECTED', 'DISCONNECTED'
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
}

/// In-app notification, one row per recipient.
///
/// `type` is an i18n KEY and `params` its interpolation values — never a
/// rendered sentence. Notifications are read days after they are written and
/// outlive any single session, so a stored English string would be permanently
/// wrong for an Albanian reader (the problem TD-016 describes for error
/// messages, but far more visible and durable here).
///
/// Within `params`, entity labels are SNAPSHOTS (the client name as it was when
/// the event happened, which is what the notification is describing) while
/// people are referenced BY ID and resolved at render time (a colleague's name
/// should read as it is now).
model Notification {
  id              String @id @default(uuid())
  tenantId        String
  recipientUserId String

  type   String
  params Json

  /// Null for system-originated events, e.g. expiry.
  actorUserId String?

  /// Deep-link target: QUOTATION | APPOINTMENT | CLIENT.
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  actor     User?  @relation("NotificationActor", fields: [actorUserId], references: [id])

  /// Serves both the unread badge and the list, which are always scoped to one
  /// recipient within one tenant and ordered newest-first.
  @@index([tenantId, recipientUserId, readAt, createdAt])
  /// Retention pruning scans by age.
  @@index([tenantId, createdAt])
}

/// A tenant-authored client intake form: titled sections ("paragraphs") laid out
/// over the tenant's own CustomFieldDefinitions, built by drag and drop.
///
/// A form owns LAYOUT ONLY. CustomFieldDefinition remains the tenant-level data
/// dictionary — what a client record can store — and a form is one presentation
/// of it. Fields cannot belong to forms: CustomFieldDefinition carries
/// @@unique([tenantId, role]), so a FieldRole is a fact about the tenant, and
/// ClientFieldResolver (called from PDF, email, search and dashboard code that
/// has no form in scope) could not answer "the client's email" if that depended
/// on which form happened to be open.
model ClientForm {
  id                      String    @id
  tenantId                String
  name                    String
  description             String?
  /// Exactly one per tenant. This is the form the internal client create/edit
  /// page renders, and the only one that shows fields not yet placed on it.
  isDefault               Boolean   @default(false)
  /// FormStatus: DRAFT | PUBLISHED | ARCHIVED. A plain String for the same
  /// reason CustomFieldDefinition.fieldType is — the authoritative list lives
  /// in src/forms/domain/enums/FormStatus.ts and new values cost no migration.
  status                  String    @default("DRAFT")
  /// The section/item tree — see src/forms/domain/value-objects/FormLayout.ts.
  /// Sections and items are deliberately NOT tables. Presentation metadata
  /// (help text, accent colour, column span, placeholder) churns constantly,
  /// and every new attribute would otherwise cost a Postgres migration folder
  /// AND a hand-written MySQL script, because schema.mysql.prisma is maintained
  /// by hand. `options` and `customFieldValues` are already Json here for the
  /// same reason. The price — no FK from an item to its definition — is paid on
  /// read: the read model resolves each fieldId against the tenant's live
  /// definitions and drops orphans, exactly as ClientFieldResolver already
  /// tolerates a deleted roled field.
  ///
  /// No @default: MySQL cannot take a literal default on a JSON column, and the
  /// application always writes it (same as Client.customFieldValues).
  layout                  Json
  /// Optimistic concurrency counter, bumped on every layout write. A layout is
  /// a whole document, so a lost update costs an entire builder session rather
  /// than one field — updates are compare-and-set on this value.
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  /// Soft delete, so a form that already produced clients keeps its identity.
  deletedAt               DateTime?
  /// Randomly-generated public share token (43 chars, base64url of 32 bytes),
  /// minted on first publish. NULL until then. This is what stands in for
  /// authentication on the client-facing fill route — same design as
  /// Quotation's share token, see src/quotations/domain/shareToken.ts.
  shareToken              String?   @unique
  /// A template is a form kept as a reusable starting point rather than one
  /// clients fill. Creating a form FROM a template deep-copies the document,
  /// so later edits to either side never propagate (spec §30).
  isTemplate              Boolean   @default(false)
  /// The FormVersion clients currently submit against. NULL until first
  /// publish. Deliberately NOT a relation field: FormVersion.formId already
  /// points back here, and a second FK in the opposite direction would make
  /// both rows un-deletable without a two-step dance.
  publishedVersionId      String?
  /// The draft `version` counter's value at the moment of the last publish.
  /// NULL until first publish. This is what "unpublished changes" is computed
  /// from (`version > publishedAtDraftVersion`) without ever diffing the
  /// draft document against the frozen FormVersion snapshot — every mutator
  /// already bumps `version`, so this is a cheap integer comparison instead
  /// of a document walk on every read.
  publishedAtDraftVersion Int?
  /// Submission settings — success message, notification recipients, whether
  /// the form is still accepting responses. Json for the same reason `layout`
  /// is: these knobs churn, and each new one would otherwise cost a Postgres
  /// migration AND a hand-written MySQL script.
  ///
  /// No @default: MySQL cannot take a literal default on a JSON column.
  settings                Json

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  versions    FormVersion[]
  submissions FormSubmission[]

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

/// An immutable published snapshot of a form's document.
///
/// The DRAFT document lives on ClientForm.layout and is mutable; publishing
/// copies it here and stamps ClientForm.publishedVersionId. Historical rows
/// are NEVER deleted — a FormSubmission is pinned to the exact version it was
/// submitted against, and deleting the version would make that submission
/// unrenderable (spec §28, brief §8).
model FormVersion {
  id                String   @id
  tenantId          String
  formId            String
  /// 1-based, monotonically increasing per form.
  versionNumber     Int
  /// The frozen FormDocument (v3) — see src/forms/domain/value-objects/FormDocument.ts.
  document          Json
  publishedAt       DateTime @default(now())
  publishedByUserId String?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  form        ClientForm       @relation(fields: [formId], references: [id])
  submissions FormSubmission[]

  @@unique([formId, versionNumber])
  @@index([tenantId, formId])
}

/// One completed response to a published form version.
///
/// `data` is a structured, machine-readable object keyed by FieldSpec.key —
/// never OCR'd or parsed back out of a PDF (spec §27). Print output is a
/// RENDERING of this row, not its source of truth.
model FormSubmission {
  id                String   @id
  tenantId          String
  formId            String
  /// Pins the submission to the exact document that produced it, so a later
  /// republish can never retroactively reinterpret what these values meant.
  formVersionId     String
  data              Json
  submittedAt       DateTime @default(now())
  /// NULL for a public submission — the person filling a shared link has no
  /// account (that is the whole point of the share token).
  submittedByUserId String?
  /// Set when the form carried client-bound fields and a Client row was
  /// created/updated from this submission.
  clientId          String?
  /// How it arrived: PUBLIC_LINK | INTERNAL.
  source            String   @default("PUBLIC_LINK")
  /// Salted hash, not a raw IP — enough to spot abuse, not PII retention.
  ipHash            String?
  userAgent         String?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  form        ClientForm  @relation(fields: [formId], references: [id])
  formVersion FormVersion @relation(fields: [formVersionId], references: [id])

  @@index([tenantId, formId, submittedAt])
  @@index([tenantId, submittedAt])
}

// ==========================================
// CONTRACTS MODULE
// ==========================================

/// A subscription a business (Client) has bought: one TERM, with its own
/// start, end, price and payment schedule.
///
/// Deliberately NOT the same thing as `Tenant.subscriptionStatus`, which says
/// whether THIS workspace may operate. That is the platform billing its
/// tenants; this is a tenant billing its own customers. The two are different
/// directions of the same word and must never be conflated — a SUSPENDED
/// tenant is locked out of the product, whereas a CANCELLED contract is just a
/// business fact about one of that tenant's clients.
///
/// One row per TERM, not per customer relationship. Renewing does not mutate
/// dates in place — it creates the next Contract pointing back at this one
/// through `renewedFromContractId`, so "what did they pay us in 2025" stays
/// answerable after the 2026 renewal. Same snapshot reasoning as
/// InvoiceLineItem copying its product price rather than referencing it.
model Contract {
  id       String @id
  tenantId String
  clientId String

  /// Which staff member owns this account. Nullable and `onDelete: Restrict`
  /// via the relation below, same as Client.assignedUserId: a deactivated
  /// salesperson must not drag their contracts out of the database with them.
  /// Drives "my contracts" filtering and who receives the expiry notification.
  assignedUserId String?

  /// The plan sold, as free text rather than an enum. Medwork's plan list is
  /// commercial, not structural — it changes with a price sheet, and a schema
  /// migration is the wrong unit of work for "we renamed Gold to Premium".
  planName String

  /// DRAFT | ACTIVE | EXPIRED | CANCELLED — see ContractStatus in
  /// src/contracts/domain/Contract.ts. A String column for the same reason
  /// every other status here is one: the authoritative list is the TypeScript
  /// enum, and adding a value needs no migration.
  status String

  /// Price for ONE billing period, not for the whole term. A 1200/year plan
  /// billed MONTHLY stores 100 here, and the term's total is derived by
  /// multiplying by the generated schedule length — storing both a period
  /// price and a term total is how the two drift apart.
  amount Float

  /// MONTHLY | QUARTERLY | ANNUAL | ONE_TIME — how often `amount` falls due.
  /// Determines how many ContractPayment rows activation generates.
  billingPeriod String

  startsAt DateTime
  /// Last day the term covers. The expiry sweep compares this against now.
  endsAt   DateTime

  /// Internal notes, private to the workspace. A dedicated column rather than
  /// a custom field, same rationale as Client.notes.
  notes String?

  /// The signed contract document, if one was uploaded. Stored as a public
  /// `/uploads/...` URL like ProductImage.url, but written by the contract
  /// document endpoint rather than MediaService: this is a PDF kept verbatim,
  /// not an image to be re-encoded through sharp.
  documentUrl  String?
  /// Original filename, so a download can be offered under the name the user
  /// recognises rather than the UUID the file is stored as.
  documentName String?

  /// The term this one renewed, if any. Unique because a term can be renewed
  /// exactly once — a second renewal of the same term would mean two live
  /// successors and no answer to "which one is current". The constraint is in
  /// the database rather than only in RenewContractUseCase for the same reason
  /// Invoice.quotationId is: the use case's check is not atomic.
  renewedFromContractId String? @unique

  activatedAt DateTime?
  cancelledAt DateTime?

  /// When the "expires soon" warning went out. NULL means not yet warned, and
  /// that is the entire dedup mechanism — the sweep selects on IS NULL, same
  /// convention as Appointment.remindedAt and Quotation.followUpSentAt.
  /// Cleared by a renewal so the next term earns its own warning.
  expiryNotifiedAt DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  client       Client @relation(fields: [clientId], references: [id])
  assignedUser User?  @relation("AssignedContracts", fields: [assignedUserId], references: [id], onDelete: Restrict)
  createdBy    User   @relation("CreatedContracts", fields: [createdByUserId], references: [id], onDelete: Restrict)

  renewedFrom Contract? @relation("ContractRenewal", fields: [renewedFromContractId], references: [id], onDelete: Restrict)
  renewedInto Contract? @relation("ContractRenewal")

  payments      ContractPayment[]
  statusHistory ContractStatusHistory[]

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  /// Drives the expiry sweep, which scans ACTIVE contracts by end date across
  /// all tenants rather than within one — same shape as Invoice's
  /// `[status, dueDate]`, for the same reason.
  @@index([status, endsAt])
}

/// One expected payment against a contract: "the March instalment".
///
/// There is no payment provider anywhere in this module and that is by design
/// — nothing here talks to a gateway, reconciles a webhook or holds a card.
/// A person collects the money however they collect it (bank transfer, cash,
/// standing order) and records that fact here by hand. `status` is therefore
/// a human assertion, not a system observation.
///
/// Rows are generated up front by ActivateContractUseCase so the schedule is
/// visible before any money moves, and stay fully editable afterwards: real
/// billing has part-payments, waived months and off-cycle extras.
model ContractPayment {
  id         String @id
  tenantId   String
  contractId String

  /// 1-based position within the generated schedule. Not a unique key — an
  /// ad-hoc payment added later shares the index of the period it falls in,
  /// which is correct: two payments can belong to the same month.
  periodIndex Int

  dueDate DateTime
  /// What is owed for this period. Copied from Contract.amount at generation
  /// time, then independently editable — a mid-term price change must not
  /// rewrite instalments the customer already paid at the old rate.
  amount  Float

  /// UNPAID | PAID | PARTIAL | WAIVED — see PaymentStatus in
  /// src/contracts/domain/ContractPayment.ts.
  status String @default("PAYMENT_PENDING")

  /// How much has actually landed. Equals `amount` for PAID and 0 for UNPAID;
  /// the field exists for PARTIAL, which is the only state where "how much is
  /// still owed" cannot be derived from the status alone.
  paidAmount Float @default(0)

  /// When the money was received — the real-world date the user enters, which
  /// is not the same as when they got round to recording it here.
  paidAt DateTime?

  /// Free text: "bank transfer", "cash", "card at reception". Not an enum,
  /// because the list is whatever this business actually does.
  method String?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, contractId, dueDate])
  /// Drives the unpaid/overdue rollup across all of a tenant's contracts.
  @@index([tenantId, status, dueDate])
}

/// Audit trail for a contract's lifecycle transitions, mirroring
/// InvoiceStatusHistory exactly — including the NULL-means-the-scheduler
/// convention on `changedByUserId`, which is what lets an EXPIRED contract's
/// own history explain that time expired it rather than a person.
model ContractStatusHistory {
  id         String @id
  tenantId   String
  contractId String
  fromStatus String
  toStatus   String

  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// `onDelete: Restrict`, stated explicitly — same rationale as
  /// InvoiceStatusHistory.changedBy: deleting a user must not silently rewrite
  /// their past status changes as "done by the scheduler".
  changedBy User?    @relation("ContractStatusChanges", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, contractId])
}

/// Admin-managed risk levels (Slice 8: FR-SET-02). A company's risk level is
/// never stored on the company: it is read through its business type (SRS
/// §7.1). `level` is the number the business uses ("Level 1") and is unique
/// in the workspace; `order` is only the display order.
model RiskLevel {
  id          String   @id
  tenantId    String
  level       Int
  nameSq      String
  /// Optional: labels fall back to Albanian when English is missing (FR-LNG-03).
  nameEn      String?
  description String?
  order       Int      @default(0)
  /// A deactivated value stays on the records that use it but is not offered
  /// for new ones. A value in use is never deleted, only deactivated.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessTypes BusinessType[]

  @@unique([tenantId, level])
  @@index([tenantId, order])
}

/// Admin-managed business types, each tied to one risk level (Slice 8:
/// FR-SET-01). Same lifecycle as RiskLevel. `Restrict` on the risk level: a
/// risk level a business type points at can be deactivated but not deleted.
model BusinessType {
  id          String   @id
  tenantId    String
  nameSq      String
  nameEn      String?
  riskLevelId String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  riskLevel RiskLevel @relation(fields: [riskLevelId], references: [id], onDelete: Restrict)

  @@index([tenantId, order])
  @@index([riskLevelId])
}

/// Predefined regions (Slice 9: FR-SET-03; Q1: Area = qark). Deactivating an
/// area with active cities is refused unless the caller cascades the
/// deactivation onto them (FR-SET-04).
model Area {
  id        String   @id
  tenantId  String
  nameSq    String
  /// Optional: labels fall back to Albanian when English is missing (FR-LNG-03).
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cities City[]

  @@index([tenantId, order])
}

/// The cities of one area (Slice 9: FR-SET-04). A name is unique within its
/// area, not across the whole workspace, so "Tiranë" can exist once per area.
/// `Restrict` on the area: an area a city points at can be deactivated but
/// not deleted.
model City {
  id        String   @id
  tenantId  String
  areaId    String
  nameSq    String
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([tenantId, areaId, nameSq])
  @@index([tenantId, areaId, order])
}

/// Days after which an unattended deal should resurface as a follow-up
/// (Slice 10: FR-SET-05). Nothing reads this list yet; the use case that
/// schedules follow-ups is Milestone 2.
model FollowUpInterval {
  id        String   @id
  tenantId  String
  days      Int
  nameSq    String
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, order])
}

/// Why a deal was marked lost (Slice 10: FR-SET-06). Nothing reads this list
/// yet; the deal that records a reason is Milestone 2.
model LostReason {
  id        String   @id
  tenantId  String
  nameSq    String
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, order])
}

/// The label, order and colour the Administrator has set for one fixed
/// status key (Slice 10: FR-SET-07, 08). `domain` and `key` are both fixed
/// in code (`StatusCatalogue.ts`) — there is no create or delete, only
/// update — so a missing row simply means the catalogue default applies.
model StatusLabel {
  tenantId  String
  domain    String
  key       String
  labelSq   String
  labelEn   String?
  colour    String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, domain, key])
}
