/**
 * PostgreSQL is the active schema, and the one `prisma/migrations` is written
 * for — every migration in that folder emits `TIMESTAMP(3)`, `JSONB` and
 * double-quoted identifiers, so `prisma migrate deploy` only ever worked here.
 * `schema.mysql.prisma` beside this file is the hand-maintained MySQL mirror
 * used by the Hostinger deployment, which is provisioned from
 * `nevacrm_full_import.sql` rather than from the migration history. The two
 * now differ ONLY in the `@db.Text` annotations MySQL needs for long strings —
 * the four array-shaped columns (tags, options, emailEventTypes,
 * emailRecipientRoles) are `Json` on both sides on purpose, so the
 * application code has exactly one shape to handle instead of branching per
 * provider. Any model change must be made in both, or the deployment drifts
 * from what the code expects.
 */
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Whether a workspace is allowed to operate.
///
/// This is the first Prisma-level enum in the schema — `UserRole` and the
/// various status fields are TypeScript enums over String columns. The
/// difference is deliberate: this value is closed, platform-controlled and
/// never user-supplied, and it gates login for an entire workspace. A bad
/// value here silently locks out or lets in a whole tenant, so the constraint
/// is worth having in the database rather than only in application code.
///
/// SUSPENDED retains all data. There is no value here meaning "deleted" —
/// hard deletion is deliberately not a thing this model can express.
enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                        String  @id
  name                      String
  urlSlug                   String  @unique
  requiresQuotationApproval Boolean @default(true)
  /// LEGACY_QUOTATIONS | SALES_PROCESS (M2 plan D6). Behaviour that differs
  /// for the Milestone 2 sales process (offer email, public quotation link,
  /// the approval switch) is keyed on this, never on the tenant slug. Slice 9
  /// sets it to SALES_PROCESS for Wellness Albania.
  salesWorkflow             String  @default("LEGACY_QUOTATIONS")
  // Workspace branding, surfaced in the sidebar, settings and customer-facing pages.
  logoUrl                   String?
  coverImageUrl             String?

  // Company profile. Like the branding URLs above, these are presentation-only
  // and are read straight from Prisma rather than through the Tenant entity.
  registrationNumber String?
  addressLine        String?
  addressCity        String?
  addressState       String?
  addressPostalCode  String?
  contactEmail       String?
  contactPhone       String?

  // Localization. Unlike the fields above these drive real behaviour (money
  // formatting, and notifications later), so they DO live on the domain entity.
  // NOT NULL with defaults so the fallback lives here and nowhere else.
  currency   String @default("USD")
  locale     String @default("en-US")
  timezone   String @default("UTC")
  dateFormat String @default("MM/DD/YYYY")

  // Interface language for the workspace. Separate from `locale` above by
  // design: locale is how things are FORMATTED, this is what language they are
  // WRITTEN in. Also the only language source available for invitation emails,
  // whose recipients have no account yet.
  defaultLanguage String @default("en")

  // Whether the workspace may operate at all. Like the localization fields
  // above this drives real behaviour — it gates login and every tenant-scoped
  // request — so it lives on the domain entity too.
  //
  // Defaulting to ACTIVE is what makes the migration safe: every tenant that
  // exists today is by definition operating, and a nullable or SUSPENDED
  // default would either introduce a third "unknown" state for every read site
  // to handle or lock out live customers on deploy.
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  // Stamped the first (and only) time EnsureDefaultClientFieldsUseCase seeds
  // this tenant's baseline client fields (Name/Email/Phone/Status/Assigned To).
  // The seeder used to decide by "which FieldRoles are missing", which meant a
  // business owner could never delete one of those fields: the next read of
  // the field list silently recreated it at the bottom of the order. This
  // stamp makes seeding a one-time event, so deletes stick.
  clientFieldsSeededAt DateTime?

  // Same one-shot reasoning as clientFieldsSeededAt, for the starter intake
  // form built from those fields (EnsureDefaultClientFormUseCase). Without the
  // stamp, "create the default form if the tenant has none" would resurrect a
  // form the owner deliberately deleted on the very next page load.
  clientFormSeededAt DateTime?

  createdAt DateTime @default(now())

  users                  User[]
  ownershipTransfers     OwnershipTransfer[]
  invitations            Invitation[]
  clients                Client[]
  contactPersons         ContactPerson[]
  customFieldDefinitions CustomFieldDefinition[]
  clientForms            ClientForm[]
  formVersions           FormVersion[]
  formSubmissions        FormSubmission[]
  outcomeCategories      OutcomeCategory[]
  interactions           Interaction[]
  appointments           Appointment[]

  // Inventory
  categories     Category[]
  warehouses     Warehouse[]
  products       Product[]
  productImages  ProductImage[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  // Quotations
  quotations Quotation[]

  // Invoices
  invoices Invoice[]

  // Contracts
  contracts Contract[]

  notifications        Notification[]
  notificationSettings NotificationSettings?

  // Integrations
  integrations Integration[]

  // Slice 3: RBAC
  roles                     Role[]
  // M2 Slice 2: permission upgrades already applied (D7)
  appliedPermissionUpgrades AppliedPermissionUpgrade[]

  // Slice 8: lookup lists
  riskLevels    RiskLevel[]
  businessTypes BusinessType[]

  // Slice 9: areas and cities
  areas  Area[]
  cities City[]

  // Slice 10: sales lists
  followUpIntervals FollowUpInterval[]
  lostReasons       LostReason[]
  activityResults   ActivityResult[]

  // Slice 10: status labels
  statusLabels StatusLabel[]

  // M2 Slice 3: pricing configuration
  pricingSettings  PricingSettings?
  employeeBands    EmployeeBand[]
  riskSurcharges   RiskSurcharge[]
  visitFrequencies VisitFrequency[]
  priceZones       PriceZone[]

  // M2 Slice 4: services and packages
  services        Service[]
  servicePackages ServicePackage[]

  // M2 Slice 5: the sales script and its versions
  salesScripts SalesScript[]

  // M2 Slice 6: deals and their stage history
  deals Deal[]

  // M2 Slice 9: yearly document numbers
  documentSequences DocumentSequence[]

  // M2 Slice 10: discount approvals above the cap (FR-DSC-03..12)
  discountApprovals DiscountApproval[]

  // M2 Slice 11: workspace sales settings (FR-DEAL-12)
  salesSettings    SalesSettings?
  contractSettings ContractSettings?

  // M4 Slice 3: Wellness+ settings
  tierSettings        TierSetting[]
  membershipSettings  MembershipSettings?
  familyRelationships FamilyRelationship[]
  benefitServices     BenefitService[]
  members             Member[]
}

/// Platform-wide default settings, applied to a workspace only at the moment
/// it is PROVISIONED — never retroactively to an existing tenant. See
/// EnterTenantUseCase's sibling, CreateTenantWithOwnerUseCase, which reads this
/// row (falling back to PlatformSettings.defaults() if it has never been saved)
/// when building a new Tenant.
///
/// Deliberately NOT a live default that existing tenants keep following: a
/// workspace's own settings, once created, are that workspace's property, and
/// changing this row must never silently move a paying customer's currency or
/// timezone out from under them. Reaching an existing tenant is a separate,
/// explicit action — the platform console's per-tenant bulk apply — not a side
/// effect of editing this row.
///
/// A genuine singleton: exactly one row, `id` fixed at 'platform' by
/// convention (see PrismaPlatformSettingsRepository) rather than modelled with
/// no primary key at all, so `upsert` has a stable target.
model PlatformSettings {
  id                        String   @id @default("platform")
  requiresQuotationApproval Boolean  @default(true)
  currency                  String   @default("USD")
  locale                    String   @default("en-US")
  timezone                  String   @default("UTC")
  dateFormat                String   @default("MM/DD/YYYY")
  defaultLanguage           String   @default("en")
  updatedAt                 DateTime @updatedAt
}

/// Per-workspace notification policy.
///
/// §6.6 of the SRS makes every notification behaviour configurable per
/// business: which events fire, who receives email, how far ahead a reminder
/// goes out, how long to wait before chasing a quotation. All of that lives
/// here, in one row per tenant, rather than as a scatter of booleans on Tenant.
///
/// The row is OPTIONAL. A tenant with no row gets `NotificationSettings.defaults()`
/// — see the domain entity. That is what makes this migration safe: no backfill
/// is required and no existing workspace changes behaviour on deploy.
model NotificationSettings {
  tenantId String @id

  /// Master switch. When false, no business event sends email at all,
  /// regardless of `emailEventTypes`. Transactional auth mail (invitations,
  /// password resets) is NOT governed by this — a workspace cannot switch off
  /// the mail that lets people into it.
  emailEnabled Boolean @default(true)

  /// Which NotificationType values also send email. Empty means "in-app only".
  /// Stored as strings rather than a Prisma enum for the same reason
  /// NotificationType is a TS const array: adding a type must not require a
  /// migration, and an unknown value here is inert rather than fatal.
  /// Json rather than a native array: MySQL (the Hostinger production target)
  /// has no array column type, so both providers store this as JSON and the
  /// application code has exactly one shape to deal with instead of two.
  emailEventTypes Json @default("[]")

  /// Which roles receive event email. A workspace can keep owners informed by
  /// mail while leaving staff on in-app only.
  emailRecipientRoles Json @default("[\"BUSINESS_OWNER\"]")

  /// Appointment reminders.
  appointmentRemindersEnabled    Boolean @default(true)
  /// Lead time in minutes. 1440 = one day before, which is the SRS's own example.
  appointmentReminderLeadMinutes Int     @default(1440)

  /// Follow-up on a sent quotation that nobody has responded to.
  quotationFollowUpEnabled Boolean @default(true)
  quotationFollowUpDays    Int     @default(3)

  /// Automatic expiry of quotations that were never answered. Distinct from the
  /// follow-up above: the follow-up nudges, this closes.
  quotationAutoExpireEnabled Boolean @default(false)
  quotationExpiryDays        Int     @default(30)

  /// M2 Slice 10: a pending discount approval older than this many hours
  /// reminds its approvers once (FR-DSC-12). Admin-controlled (Settings → Notifications).
  discountApprovalReminderHours Int @default(24)

  /// M2 Slice 11: a follow-up that reaches its due time notifies its
  /// salesperson in the app (FR-FUP-09).
  followUpDueNotificationsEnabled Boolean @default(true)
  /// M2 Slice 11: a 07:30 email listing each salesperson's follow-ups for the
  /// day, in the workspace time zone (FR-FUP-09). Off until switched on.
  followUpDailySummaryEnabled     Boolean @default(false)
  /// The workspace day (YYYY-MM-DD) whose summary has gone out. Written only
  /// by the scheduler, which claims a day by moving this forward, so one day
  /// is never summarised twice.
  followUpSummarySentOn           String?

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id
  email          String
  hashedPassword String
  firstName      String?
  lastName       String?
  phone          String?
  role           String // 'SUPER_ADMIN', 'BUSINESS_OWNER', 'STAFF'
  // Slice 3: the permission-bearing role. NULL for every user created before
  // this migration and for SUPER_ADMIN, which sits outside the role table
  // (D2 in the Milestone 1 plan) — ResolveAccessContextUseCase falls back to
  // LegacyRoleMapping (keyed on `role` above) whenever this is NULL, so the
  // rollback path (dropping this column) stays safe. `role` itself is kept,
  // unchanged, for that same rollback and because SUPER_ADMIN has no row here.
  roleId         String?
  // Soft off-boarding. A hard delete is impossible: seven non-nullable columns
  // reference User (Quotation.createdByUserId, Appointment.assignedUserId,
  // Client.lastUpdatedByUserId, ...), so RESTRICT blocks it and cascading would
  // destroy financial and audit history. Same reasoning as ProductInUseError.
  isActive       Boolean   @default(true)
  // Platform Admin soft-delete. Set together with isActive=false, but distinct
  // from ordinary suspension: a deleted user's email/name/phone are also
  // anonymized (see DeleteUserUseCase), and there is no route back from this —
  // unlike suspension, which reactivation reverses. The row survives, never
  // hard-deleted, for the same seven-FK-RESTRICT reason isActive does.
  deletedAt      DateTime?
  // Interface language override. NULL means "follow the workspace default" —
  // distinct from having explicitly chosen English.
  language       String?
  // Profile media. Store the public URL of the canonical (1x) asset; the
  // responsive variants are derived from it by convention (see MediaService).
  avatarUrl      String?
  coverImageUrl  String?
  tenantId       String?
  createdAt      DateTime  @default(now())

  tenant                            Tenant?                  @relation(fields: [tenantId], references: [id])
  warehouseId                       String?
  warehouse                         Warehouse?               @relation("UserWarehouse", fields: [warehouseId], references: [id])
  passwordResetTokens               PasswordResetToken[]
  assignedClients                   Client[]                 @relation("AssignedClients")
  updatedClients                    Client[]                 @relation("LastUpdatedClients")
  interactions                      Interaction[]            @relation("InteractionAuthor")
  updatedInteractions               Interaction[]            @relation("InteractionUpdatedBy")
  assignedAppointments              Appointment[]            @relation("AssignedAppointments")
  inventoryMovements                StockMovement[]
  quotations                        Quotation[]
  statusChanges                     QuotationStatusHistory[]
  invoices                          Invoice[]
  invoiceStatusChanges              InvoiceStatusHistory[]
  assignedContracts                 Contract[]               @relation("AssignedContracts")
  createdContracts                  Contract[]               @relation("CreatedContracts")
  contractStatusChanges             ContractStatusHistory[]  @relation("ContractStatusChanges")
  contractPaymentChanges            ContractPaymentHistory[] @relation("ContractPaymentChanges")
  contractDocumentUploads           ContractDocument[]       @relation("ContractDocumentUploads")
  notifications                     Notification[]           @relation("NotificationRecipient")
  causedNotifications               Notification[]           @relation("NotificationActor")
  sentInvitations                   Invitation[]             @relation("InvitationSender")
  ownershipTransfersAsOriginalOwner OwnershipTransfer[]      @relation("OwnershipTransferOriginalOwner")
  ownershipTransfersAsActingOwner   OwnershipTransfer[]      @relation("OwnershipTransferActingOwner")
  salesScriptsCreated               SalesScript[]            @relation("SalesScriptCreatedBy")
  salesScriptsPublished             SalesScript[]            @relation("SalesScriptPublishedBy")
  ownedDeals                        Deal[]                   @relation("DealOwner")
  createdDeals                      Deal[]                   @relation("DealCreatedBy")
  dealStageChanges                  DealStageHistory[]       @relation("DealStageChanges")
  requestedDiscountApprovals        DiscountApproval[]       @relation("DiscountApprovalRequestedBy")
  decidedDiscountApprovals          DiscountApproval[]       @relation("DiscountApprovalDecidedBy")

  assignedRole Role? @relation(fields: [roleId], references: [id])

  @@index([roleId])
}

/// Slice 3 (FR-RBAC-01, 02): one of a tenant's five system roles, or a custom
/// role created by copying one (FR-RBAC-04, Slice 6). A role IS a set of
/// permissions — the permissions themselves are `RolePermission` rows, never
/// hard-coded per role name, so granting or revoking one needs no deployment
/// (FR-RBAC-02's acceptance criterion). `key` is the stable identifier code
/// checks against (`SALES_USER`, `SALES_MANAGER`, `RECEPTION`,
/// `ADMINISTRATOR`, `CEO` for system roles); `nameSq`/`nameEn` are what the
/// Roles admin screen (Slice 6) shows. `isSystem` roles cannot be deleted and
/// their `key` cannot change, but their permissions can (FR-RBAC-03).
model Role {
  id        String   @id
  tenantId  String
  key       String
  nameSq    String
  nameEn    String
  isSystem  Boolean  @default(false)
  /// For a custom role (Slice 6, FR-RBAC-04): the system role key it was
  /// copied from, directly or through another copy. NULL for a system role.
  /// Team scope and the legacy `User.role` string follow this lineage.
  baseKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// One permission grant on a `Role` (FR-RBAC-02). `permissionKey` is a key
/// from the in-code `PermissionCatalogue` (`src/access/domain`), never
/// validated by a foreign key — the catalogue is code, not data, per
/// FR-RBAC-02. `scope` is OWN/TEAM/ALL for a scoped permission
/// (`PermissionCatalogue` entries marked `supportsScope`), and NULL for a
/// plain capability (e.g. `users.manage`), where holding the row at all is
/// the grant.
model RolePermission {
  roleId        String
  permissionKey String
  scope         String?

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

/// A permission upgrade (src/access/domain/PermissionUpgrades.ts) that has
/// run for this tenant (M2 plan D7). The upgrade inserts a milestone's new
/// keys into the system roles only while this row is absent, so a grant the
/// Administrator revokes afterwards is never put back.
model AppliedPermissionUpgrade {
  tenantId  String
  key       String
  appliedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
}

/// Records a temporary Business-Owner promotion created when a Platform Admin
/// suspends a Business Owner who still has active staff (see SuspendUserUseCase).
/// Reactivation reads the ACTIVE row to offer "restore original ownership",
/// "keep current ownership" or "keep both as Business Owners"
/// (PlatformReactivateUserUseCase), then resolves it to RESTORED, KEPT or
/// KEPT_BOTH — a terminal state, never reused. KEPT_BOTH demotes nobody: a
/// workspace may have any number of Business Owners.
///
/// Only created for suspension. A Business Owner deletion that transfers
/// ownership is permanent by construction (the original owner is gone), so it
/// has no row here — just an AuditLog entry.
model OwnershipTransfer {
  id                        String    @id
  tenantId                  String
  originalOwnerId           String
  actingOwnerId             String
  // The acting owner's role/warehouse before promotion, so "restore" can put
  // them back exactly where they were.
  previousActingRole        String
  previousActingWarehouseId String?
  // The acting owner's permission role (User.roleId) before promotion, so a
  // restore gives back exactly the role they held. Null on transfers recorded
  // before Slice 15; restore then maps previousActingRole (D2).
  previousActingRoleId      String?
  status                    String // 'ACTIVE' | 'RESTORED' | 'KEPT' | 'KEPT_BOTH'
  createdAt                 DateTime  @default(now())
  createdByUserId           String
  resolvedAt                DateTime?
  resolvedByUserId          String?

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  originalOwner User   @relation("OwnershipTransferOriginalOwner", fields: [originalOwnerId], references: [id])
  actingOwner   User   @relation("OwnershipTransferActingOwner", fields: [actingOwnerId], references: [id])

  @@index([originalOwnerId, status])
  @@index([actingOwnerId, status])
}

/// Append-only record of platform-administrative actions. Deliberately has no
/// foreign keys: an audit trail must survive the very rows it describes (a
/// soft-deleted user's history should not become unreadable), so actor/target
/// ids are plain strings rather than relations.
model AuditLog {
  id          String   @id
  actorUserId String
  actorRole   String
  action      String // e.g. 'USER_SUSPENDED', 'USER_REACTIVATED', 'USER_DELETED', 'USER_INVITED', 'OWNERSHIP_TRANSFERRED'
  targetType  String // 'USER'
  targetId    String
  tenantId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([tenantId])
}

/// Append-only, tenant-scoped compliance trail (Slice 2: FR-AUD-01). Every
/// sensitive write in a tenant's workspace — contracts, payments, users,
/// roles, settings — lands here as one row with the field-level old and new
/// values, written in the same transaction as the change (FR-AUD-04). No
/// foreign keys, for the same reason as `AuditLog`: the trail must outlive
/// the rows it describes. Distinct from `AuditLog`, which stays the record of
/// platform-operator actions (D5 in the Milestone 1 plan).
model AuditEntry {
  id       String   @id
  tenantId String
  at       DateTime @default(now())

  /// NULL means a system actor (the scheduler), not a person — `userRole` is
  /// then `'SYSTEM'`. See `SYSTEM_ACTOR` in `src/audit/domain/AuditEntry.ts`.
  userId   String?
  userRole String

  /// CREATE | UPDATE | DELETE | STATUS_CHANGE — see AuditAction in
  /// src/audit/domain/AuditAction.ts. A String column for the same reason
  /// every other status here is one.
  action String

  entityType  String
  entityId    String
  entityLabel String?

  /// AuditChange[] — [{field, old, new}], JSON-safe and already redacted for
  /// secret fields by `diff()` before it ever reaches this column.
  changes Json

  @@index([tenantId, at])
  @@index([tenantId, entityType, entityId])
}

model Invitation {
  id              String    @id
  // Nullable: a Platform Admin invitation belongs to no workspace.
  tenantId        String?
  email           String
  role            String
  // The role the account is created with (Slice 5). Null only for a Platform
  // Admin invitation, which has no workspace and so no role table.
  roleId          String?
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  warehouseId     String?
  // Who sent it. Nullable because invitations predating this column exist and
  // cannot be attributed retroactively; new ones always carry a sender.
  invitedByUserId String?

  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  warehouse    Warehouse? @relation("InvitationWarehouse", fields: [warehouseId], references: [id])
  invitedBy    User?      @relation("InvitationSender", fields: [invitedByUserId], references: [id])
  assignedRole Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([roleId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Client {
  // name/email/phone/status/assignedUserId are being dissolved into the
  // tenant-editable CustomFieldDefinition system (see FieldRole) so a
  // business owner can rename/retype/delete/reorder every client field,
  // including these. Kept nullable here during the transition: existing
  // rows/tooling can still read them, but customFieldValues is the
  // authoritative source going forward — see ClientFieldResolver.
  id                  String    @id
  tenantId            String
  name                String?
  email               String?
  phone               String?
  status              String? // legacy: 'PROSPECT', 'ACTIVE', 'INACTIVE'
  assignedUserId      String?
  customFieldValues   Json
  /// Free-text internal notes about the client, private to the workspace.
  /// A dedicated column rather than an entry in customFieldValues: those are
  /// tenant-defined and validated against the tenant's live definitions, and a
  /// tenant that deleted the definition would lose the notes with it. This is
  /// a system field, always present, never renameable.
  notes               String?
  // The Slice 11 company profile (FR-CMP-01, 02, 03). Nullable at the
  // database level until Slice 14 backfills existing rows; the application
  // requires all of them for a company created or edited through the
  // company form. Risk level is deliberately not stored here — it is always
  // read through businessTypeId (SRS §7.1), so recolouring or reclassifying
  // a business type updates every company's risk without a migration.
  businessTypeId      String?
  employeeCount       Int?
  areaId              String?
  cityId              String?
  streetAddress       String?
  /// NIPT. Unique per tenant when filled (Q8); many companies have none yet.
  taxId               String?
  website             String?
  lastUpdatedByUserId String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Soft delete, same reasoning as User.deletedAt above. A hard delete is
  // impossible here too: Interaction/Appointment/Quotation/Invoice each hold a
  // non-nullable clientId with no cascade rule, so RESTRICT blocks removing any
  // client who has ever been booked or invoiced — and cascading would destroy
  // issued invoices, rewriting historical revenue. NULL means active; every
  // client-facing read filters on it. Reversible, unlike User.deletedAt.
  deletedAt           DateTime?

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  assignedUser      User?           @relation("AssignedClients", fields: [assignedUserId], references: [id])
  lastUpdatedByUser User            @relation("LastUpdatedClients", fields: [lastUpdatedByUserId], references: [id])
  businessType      BusinessType?   @relation(fields: [businessTypeId], references: [id], onDelete: Restrict)
  area              Area?           @relation(fields: [areaId], references: [id], onDelete: Restrict)
  city              City?           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  interactions      Interaction[]
  appointments      Appointment[]
  quotations        Quotation[]
  invoices          Invoice[]
  contracts         Contract[]
  contactPersons    ContactPerson[]
  deals             Deal[]

  @@unique([tenantId, taxId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, name])
  @@index([tenantId, businessTypeId])
  @@index([tenantId, areaId, cityId])
  employedMembers       Member[] @relation("MemberEmployer")
  formerEmployedMembers Member[] @relation("MemberFormerEmployer")
}

/// A named person at a company (FR-CMP-04, Slice 12): name, position, phone
/// and email. Exactly one contact per company is primary — enforced in
/// CompanyContacts, not here, since it's a fact about the set, not one row.
model ContactPerson {
  id       String @id
  tenantId String
  clientId String

  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete (NFR-SEC-03): a removed contact is left out of every read
  /// and out of search, never hard-deleted.
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interactions Interaction[]
  /// M2 Slice 9: offers addressed to this contact (FR-OFR-02).
  offers       Quotation[]
  /// M2 Slice 11: follow-ups with this contact.
  appointments Appointment[]

  @@index([tenantId, clientId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model CustomFieldDefinition {
  id        String  @id
  tenantId  String
  fieldName String
  // Stored as a plain String rather than a Postgres enum, so the authoritative
  // list is src/clients/domain/enums/FieldType.ts and adding a value needs no
  // migration. Currently: TEXT, NUMBER, DATE, BOOLEAN, ALPHANUMERIC, LONG_TEXT,
  // SINGLE_SELECT, MULTI_SELECT, EMAIL, USER_REFERENCE.
  fieldType String
  // Json rather than a native array: MySQL (the Hostinger production target)
  // has no array column type, so both providers store this as JSON.
  options   Json    @default("[]") // for SINGLE_SELECT
  // Display order within the tenant's field list (client form/detail/settings).
  order     Int     @default(0)
  // Tags this field as the tenant's designated field for a system concern
  // (search/PDFs/email delivery/reports/dashboard scoping) — see
  // src/clients/domain/enums/FieldRole.ts and ClientFieldResolver. Plain
  // String for the same reason fieldType is. At most one field per
  // (tenantId, role); NULL is distinct per row in both Postgres and MySQL
  // so unroled fields are unaffected.
  role      String?
  required  Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, fieldName])
  @@unique([tenantId, role])
}

model OutcomeCategory {
  id       String @id
  tenantId String
  label    String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  interactions Interaction[]

  @@unique([tenantId, label])
}

/// A recorded activity (M2 Slice 7, FR-ACT-01, 02). Every channel except NOTE
/// records when it happened, the contact person and a result; the old
/// `outcomeCategoryId` stays until Milestone 3 (D5). Rows from before Slice 7
/// were backfilled with `occurredAt = createdAt` (FR-ACT-07), so `occurredAt`
/// is nullable only for the migration. `updatedAt` NULL means never edited.
model Interaction {
  id                String    @id
  tenantId          String
  clientId          String
  authorUserId      String
  content           String
  channel           String // MEETING, CALL, NOTE, EMAIL, VISIT, ONLINE_MEETING
  outcomeCategoryId String?
  createdAt         DateTime  @default(now())
  occurredAt        DateTime?
  contactPersonId   String?
  dealId            String?
  resultId          String?
  clientFeedback    String?
  nextAction        String?
  updatedAt         DateTime?
  updatedByUserId   String?

  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  client            Client           @relation(fields: [clientId], references: [id])
  authorUser        User             @relation("InteractionAuthor", fields: [authorUserId], references: [id])
  outcomeCategory   OutcomeCategory? @relation(fields: [outcomeCategoryId], references: [id])
  /// Restrict: contacts, deals and results are soft-deleted or refused while
  /// in use, never removed under an activity.
  contactPerson     ContactPerson?   @relation(fields: [contactPersonId], references: [id], onDelete: Restrict)
  deal              Deal?            @relation(fields: [dealId], references: [id], onDelete: Restrict)
  result            ActivityResult?  @relation(fields: [resultId], references: [id], onDelete: Restrict)
  updatedBy         User?            @relation("InteractionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  /// M2 Slice 11: the follow-up this activity completed (FR-FUP-06).
  completedFollowUp Appointment?     @relation("FollowUpCompletion")

  @@index([tenantId, clientId])
  @@index([tenantId, authorUserId])
  @@index([tenantId, clientId, occurredAt])
  @@index([tenantId, dealId, occurredAt])
  /// M3 Slice 12: a salesperson's activities in a period (FR-PRF-03).
  @@index([tenantId, authorUserId, occurredAt])
  @@index([contactPersonId])
  @@index([dealId])
  @@index([resultId])
  @@index([updatedByUserId])
}

model Appointment {
  id             String   @id
  tenantId       String
  clientId       String
  assignedUserId String
  scheduledAt    DateTime
  status         String // 'SCHEDULED', 'CONFIRMED', 'COMPLETED', 'CANCELLED'
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// When the pre-appointment reminder was sent. NULL means "not yet reminded".
  ///
  /// Set to NULL again by a reschedule: moving an appointment makes the old
  /// reminder describe a time that no longer exists, so the new time earns a
  /// new reminder. This is the whole dedup mechanism — the sweep selects on
  /// `remindedAt IS NULL`, so a reminder can never go twice for one time.
  remindedAt DateTime?

  /// M2 Slice 11 (plan D1): one scheduled-activity entity. FOLLOW_UP is a
  /// follow-up (FR-FUP-01); PLANNED is a planned meeting, visit, online
  /// meeting or call (Slice 12). Existing rows are PLANNED meetings.
  kind                   String    @default("PLANNED")
  /// CALL, EMAIL, VISIT, MEETING or ONLINE_MEETING: the type of contact.
  type                   String    @default("MEETING")
  dealId                 String?
  contactPersonId        String?
  endAt                  DateTime?
  place                  String?
  /// The interval a follow-up was scheduled with (+3, +5, +7), or NULL for a
  /// custom date. Keeps an interval that is in use from being deleted.
  intervalDays           Int?
  /// The activity that completed the follow-up (FR-FUP-06).
  completedInteractionId String?   @unique
  cancelReason           String?
  /// When the follow-up's "due now" notification went out (FR-FUP-09). NULL
  /// means not yet; a reschedule clears it, as it clears `remindedAt`.
  dueNotifiedAt          DateTime?
  /// M3 Slice 12 (FR-PRF-05): when the follow-up was completed. NULL while open.
  completedAt            DateTime?

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  client               Client                @relation(fields: [clientId], references: [id])
  assignedUser         User                  @relation("AssignedAppointments", fields: [assignedUserId], references: [id])
  auditLogs            AppointmentAuditLog[]
  /// Restrict: deals and contacts are soft-deleted, activities never removed
  /// under a follow-up.
  deal                 Deal?                 @relation(fields: [dealId], references: [id], onDelete: Restrict)
  contactPerson        ContactPerson?        @relation(fields: [contactPersonId], references: [id], onDelete: Restrict)
  completedInteraction Interaction?          @relation("FollowUpCompletion", fields: [completedInteractionId], references: [id], onDelete: Restrict)

  @@index([tenantId, scheduledAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, clientId])
  /// Drives the reminder sweep, which scans upcoming appointments by status and
  /// time across all tenants rather than within one.
  @@index([status, scheduledAt])
  /// "My follow-ups", the overdue count and the calendar (M2 Slice 11, 12).
  @@index([tenantId, assignedUserId, status, scheduledAt])
  /// M3 Slice 12: follow-ups completed in a period (FR-PRF-03).
  @@index([tenantId, completedAt])
  /// A deal's follow-ups, its next one and its overdue marker (FR-DEAL-12).
  @@index([tenantId, dealId, status])
  @@index([dealId])
  @@index([contactPersonId])
}

model AppointmentAuditLog {
  id            String   @id @default(uuid())
  appointmentId String
  previousDate  DateTime
  newDate       DateTime
  reason        String
  changedBy     String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

// ==========================================
// INVENTORY MODULE
// ==========================================

model Category {
  id          String   @id
  tenantId    String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
}

model Warehouse {
  id        String   @id
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  managers           User[]              @relation("UserWarehouse")
  invitations        Invitation[]        @relation("InvitationWarehouse")
  stockLevels        StockLevel[]
  movements          StockMovement[]     @relation("AdjustmentWarehouse")
  movementsFrom      StockMovement[]     @relation("FromWarehouse")
  movementsTo        StockMovement[]     @relation("ToWarehouse")
  quotationLineItems QuotationLineItem[]
  invoiceLineItems   InvoiceLineItem[]

  @@unique([tenantId, name])
}

model Product {
  id                String   @id
  tenantId          String
  name              String
  description       String
  sku               String?
  brand             String?
  categoryId        String?
  price             Float
  // Unit cost. Nullable because a catalogue can be priced before it is costed.
  cost              Float?
  // Json rather than a native array: MySQL (the Hostinger production target)
  // has no array column type, so both providers store this as JSON.
  tags              Json     @default("[]")
  lowStockThreshold Int      @default(10)
  // Archived products stay queryable (quotations reference them) but drop out
  // of the default catalogue view. Availability is always derived from stock.
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  stockLevels        StockLevel[]
  movements          StockMovement[]
  images             ProductImage[]
  quotationLineItems QuotationLineItem[]
  invoiceLineItems   InvoiceLineItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([tenantId, isArchived])
}

model ProductImage {
  id        String   @id
  tenantId  String
  productId String
  // Public URL of the @1x rendition; @2x is derived by naming convention.
  url       String
  url2x     String
  width     Int
  height    Int
  bytes     Int
  // Zero-based gallery order. Position 0 is the product's primary image.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, position])
}

model StockLevel {
  id                String @id
  tenantId          String
  productId         String
  productTenantId   String
  warehouseId       String
  warehouseTenantId String
  quantity          Int

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, productId, warehouseId])
}

model StockMovement {
  id              String   @id
  tenantId        String
  productId       String
  warehouseId     String? // Used for ADJUSTMENT
  fromWarehouseId String? // Used for TRANSFER
  toWarehouseId   String? // Used for TRANSFER
  quantity        Int
  type            String // 'ADJUSTMENT', 'TRANSFER'
  reason          String?
  createdBy       String
  createdAt       DateTime @default(now())

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])
  warehouse     Warehouse? @relation("AdjustmentWarehouse", fields: [warehouseId], references: [id])
  fromWarehouse Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  authorUser    User       @relation(fields: [createdBy], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, fromWarehouseId])
  @@index([tenantId, toWarehouseId])
  @@index([tenantId, createdAt])
}

// ==========================================
// QUOTATIONS MODULE
// ==========================================

model Quotation {
  id              String    @id @default(uuid())
  tenantId        String
  clientId        String
  createdByUserId String
  status          String
  sentAt          DateTime?
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Unguessable capability token for the customer-facing view.
  ///
  /// Issued when the quotation first reaches SENT and never reissued, so the
  /// link in a customer's inbox keeps working. NULL for everything that has not
  /// been sent — which is what makes an unsent quotation unreachable rather
  /// than merely unadvertised.
  ///
  /// Globally unique rather than unique-per-tenant on purpose: the public route
  /// has no tenant context to scope by, so the token IS the lookup key.
  shareToken         String?   @unique
  shareTokenIssuedAt DateTime?

  /// When the unanswered-quotation follow-up was sent. NULL means "not yet
  /// chased". A column rather than a query over Notification because the
  /// notification table is pruned on a retention policy and a chase must never
  /// repeat because its record aged out.
  followUpSentAt DateTime?

  /// M2 Slice 8: an offer belongs to exactly one deal (FR-OFR-01). NULL for
  /// the legacy quotations, which have no deal and get none invented (D5).
  dealId          String?
  language        String  @default("sq")
  note            String?
  /// The inputs priced (D2): ids plus their sq/en labels, so the offer reads
  /// the same after a list is renamed. The FK columns below repeat the ids
  /// the pricing lists need for their "in use" rule.
  pricingInputs   Json?
  /// The rule values used (D2, FR-OFR-04, FR-PCF-10). Decimals as strings.
  ruleSnapshot    Json?
  employeesPriced Int?
  packageId       String?
  frequencyId     String?
  zoneId          String?

  /// Amounts calculated on the server when the offer was saved (FR-OFR-03).
  /// NULL on a "Price on request" draft (FR-PRC-07) and on legacy quotations.
  baseFee            Decimal? @db.Decimal(12, 2)
  riskFee            Decimal? @db.Decimal(12, 2)
  visitFee           Decimal? @db.Decimal(12, 2)
  locationFee        Decimal? @db.Decimal(12, 2)
  listPrice          Decimal? @db.Decimal(12, 2)
  discountPercent    Decimal? @db.Decimal(7, 2)
  discountAmount     Decimal? @db.Decimal(12, 2)
  netMonthlyPrice    Decimal? @db.Decimal(12, 2)
  pricePerEmployee   Decimal? @db.Decimal(12, 2)
  annualValue        Decimal? @db.Decimal(12, 2)
  // FR-PRC-09: a manual price on a "Price on request" offer (M2 Slice 10)
  manualMonthlyPrice Decimal? @db.Decimal(12, 2)
  manualPriceReason  String?  @db.Text

  /// M2 Slice 9: the offer's number (FR-OFR-08), e.g. OF-2026-0001, given
  /// from DocumentSequence when the quotation is created and never reused.
  /// A revision keeps the number and takes the next version (FR-OFR-11).
  /// NULL only on a row the reference migration has not reached.
  number            String?
  version           Int       @default(1)
  /// The version this one revises. SetNull: the history row is the record.
  previousVersionId String?
  /// Set when a later version replaces this one: it is then read-only and
  /// can no longer be accepted or expire (FR-OFR-11).
  supersededAt      DateTime?
  /// When the offer became READY, and the sent date + validity days once it
  /// is marked as sent (FR-OFR-10). A calendar date in the tenant's zone.
  readyAt           DateTime?
  validUntil        DateTime? @db.Date
  /// Frozen when the offer becomes READY (D2): the company, contact,
  /// salesperson, Wellness Albania details and the sq/en offer texts, so the
  /// PDF reads the same after any of them change (FR-OFR-04).
  renderSnapshot    Json?
  /// The contact the offer is addressed to; NULL means the company's primary
  /// contact (FR-OFR-02).
  contactPersonId   String?

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  client          Client          @relation(fields: [clientId], references: [id])
  createdBy       User            @relation(fields: [createdByUserId], references: [id])
  /// Restrict: deals are only soft-deleted, and a priced list value referenced
  /// by an offer is in use, so it is deactivated rather than deleted.
  deal            Deal?           @relation("DealOffers", fields: [dealId], references: [id], onDelete: Restrict)
  package         ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  frequency       VisitFrequency? @relation(fields: [frequencyId], references: [id], onDelete: Restrict)
  zone            PriceZone?      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  contactPerson   ContactPerson?  @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  previousVersion Quotation?      @relation("QuotationVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  laterVersions   Quotation[]     @relation("QuotationVersions")

  lineItems         QuotationLineItem[]
  services          QuotationService[]
  statusHistory     QuotationStatusHistory[]
  discountApprovals DiscountApproval[]

  /// At most one — converting a second time is refused by
  /// ConvertQuotationToInvoiceUseCase and, decisively, by Invoice.quotationId
  /// being @unique. No `@relation` needed on this side beyond the implicit
  /// back-reference: Prisma infers the one-to-one from Invoice's unique FK.
  invoice Invoice?

  wonDeals  Deal[]     @relation("DealWonQuotation")
  contracts Contract[]

  @@unique([tenantId, number, version])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  /// Drives the follow-up and auto-expiry sweeps, which both scan SENT
  /// quotations by age across all tenants.
  @@index([status, sentAt])
  /// M3 Slice 12: offers sent in a period (FR-PRF-03).
  @@index([tenantId, sentAt])
  @@index([tenantId, createdByUserId, createdAt])
  @@index([tenantId, dealId, status])
  @@index([dealId])
  @@index([packageId])
  @@index([frequencyId])
  @@index([zoneId])
  /// Drives the offer expiry sweep (FR-OFR-13).
  @@index([tenantId, status, validUntil])
  @@index([contactPersonId])
  @@index([previousVersionId])
}

/// M2 Slice 8: a service of the offer's package, copied when the offer is
/// saved (FR-PRC-11, FR-OFR-04), so the offer keeps its text after the
/// package or the service changes. It has no price (Q11): the offer's totals
/// are the Decimal columns on Quotation. Legacy product lines stay in
/// QuotationLineItem.
model QuotationService {
  id            String  @id
  tenantId      String
  quotationId   String
  /// SetNull: the copied text is the record; the link is for reference.
  serviceId     String?
  nameSq        String
  nameEn        String?
  descriptionSq String?
  descriptionEn String?
  order         Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, quotationId])
  @@index([quotationId])
  @@index([serviceId])
}

/// M2 Slice 9: the next number of a document kind, per tenant and year (D5,
/// FR-OFR-08). Incremented under a row lock inside the transaction that
/// creates the document, so a failed create gives its number back and two
/// creates never share one. A number handed out is never reused, even if the
/// draft that took it is deleted.
model DocumentSequence {
  tenantId String
  /// OFFER today.
  kind     String
  /// The calendar year in the tenant's time zone.
  year     Int
  next     Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind, year])
}

/// M2 Slice 10: a request to apply a discount above the cap (FR-DSC-03..12).
/// Discount-only: manual prices (FR-PRC-09) are deferred, so there is no
/// MANUAL_PRICE kind yet. A new request supersedes the offer's earlier pending
/// one; amounts stay on the offer, this row holds what was asked and decided.
model DiscountApproval {
  id                    String    @id @default(uuid())
  tenantId              String
  quotationId           String
  requestedByUserId     String
  /// DISCOUNT (above the cap) or MANUAL_PRICE (FR-PRC-09)
  kind                  String    @default("DISCOUNT")
  requestedPercent      Decimal?  @db.Decimal(7, 2)
  requestedMonthlyPrice Decimal?  @db.Decimal(12, 2)
  listPriceAtRequest    Decimal?  @db.Decimal(12, 2)
  approvedPercent       Decimal?  @db.Decimal(7, 2)
  approvedMonthlyPrice  Decimal?  @db.Decimal(12, 2)
  reason                String    @db.Text
  status                String    @default("PENDING")
  decidedByUserId       String?
  decidedAt             DateTime?
  comment               String?   @db.Text
  remindedAt            DateTime?
  createdAt             DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("DiscountApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy   User?     @relation("DiscountApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, quotationId])
  @@index([quotationId])
}

model QuotationLineItem {
  id          String @id @default(uuid())
  tenantId    String
  quotationId String
  productId   String
  warehouseId String
  quantity    Int
  unitPrice   Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, quotationId])
}

model QuotationStatusHistory {
  id          String @id @default(uuid())
  tenantId    String
  quotationId String
  fromStatus  String
  toStatus    String

  /// NULL means the scheduler made this change, not a person.
  ///
  /// Automatic expiry has no acting user, and the two available alternatives
  /// were both worse: attributing it to the quotation's creator would put a
  /// change in the audit trail under the name of someone who did not make it,
  /// and inventing a "system" User row would put a login-shaped record in a
  /// table where every other row can authenticate. NULL says exactly what
  /// happened.
  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict` is stated explicitly, not left to the default.
  ///
  /// Making this relation optional flipped Prisma's implicit default from
  /// RESTRICT to SET NULL — which would mean deleting a User silently rewrote
  /// their past status changes as "done by the scheduler". NULL here has one
  /// meaning and it is not "we lost the name". Deleting a user with history
  /// stays blocked; off-boarding is `User.isActive`, as it already was.
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, quotationId])
}

// ==========================================
// INVOICES MODULE
// ==========================================

model Invoice {
  id       String @id @default(uuid())
  tenantId String
  clientId String

  /// Created by converting exactly one ACCEPTED Quotation — enforced by this
  /// unique constraint, the actual guarantee under concurrency (the use case's
  /// own "does one already exist" check is a defensive, non-atomic mirror of
  /// this).
  quotationId     String    @unique
  createdByUserId String
  status          String
  dueDate         DateTime
  sentAt          DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])
  createdBy User      @relation(fields: [createdByUserId], references: [id])

  lineItems     InvoiceLineItem[]
  statusHistory InvoiceStatusHistory[]

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  /// Drives the overdue sweep (InvoiceOverdueJob), which scans SENT invoices
  /// by due date across all tenants — same shape as Quotation's
  /// `[status, sentAt]` index for the same reason.
  @@index([status, dueDate])
}

model InvoiceLineItem {
  id        String @id @default(uuid())
  tenantId  String
  invoiceId String

  /// Copied from the source QuotationLineItem at conversion time — a
  /// snapshot, not a live reference. A quotation edited after conversion must
  /// not retroactively change an issued invoice.
  productId   String
  warehouseId String
  quantity    Int
  unitPrice   Float

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, invoiceId])
}

model InvoiceStatusHistory {
  id         String @id @default(uuid())
  tenantId   String
  invoiceId  String
  fromStatus String
  toStatus   String

  /// NULL means the scheduler made this change, not a person — same
  /// convention as QuotationStatusHistory.changedByUserId, for the same
  /// reason: automatic overdue detection has no acting user.
  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict`, stated explicitly — same rationale as
  /// QuotationStatusHistory.changedBy: deleting a user must not silently
  /// rewrite their past status changes as "done by the scheduler".
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
}

// ==========================================
// SETTINGS / INTEGRATIONS MODULE
// ==========================================

model Integration {
  id        String   @id
  tenantId  String
  provider  String // e.g., 'GOOGLE_CALENDAR'
  status    String // 'CONNECTED', 'DISCONNECTED'
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
}

/// In-app notification, one row per recipient.
///
/// `type` is an i18n KEY and `params` its interpolation values — never a
/// rendered sentence. Notifications are read days after they are written and
/// outlive any single session, so a stored English string would be permanently
/// wrong for an Albanian reader (the problem TD-016 describes for error
/// messages, but far more visible and durable here).
///
/// Within `params`, entity labels are SNAPSHOTS (the client name as it was when
/// the event happened, which is what the notification is describing) while
/// people are referenced BY ID and resolved at render time (a colleague's name
/// should read as it is now).
model Notification {
  id              String @id @default(uuid())
  tenantId        String
  recipientUserId String

  type   String
  params Json

  /// Null for system-originated events, e.g. expiry.
  actorUserId String?

  /// Deep-link target: QUOTATION | APPOINTMENT | CLIENT.
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  actor     User?  @relation("NotificationActor", fields: [actorUserId], references: [id])

  /// Serves both the unread badge and the list, which are always scoped to one
  /// recipient within one tenant and ordered newest-first.
  @@index([tenantId, recipientUserId, readAt, createdAt])
  /// Retention pruning scans by age.
  @@index([tenantId, createdAt])
}

/// A tenant-authored client intake form: titled sections ("paragraphs") laid out
/// over the tenant's own CustomFieldDefinitions, built by drag and drop.
///
/// A form owns LAYOUT ONLY. CustomFieldDefinition remains the tenant-level data
/// dictionary — what a client record can store — and a form is one presentation
/// of it. Fields cannot belong to forms: CustomFieldDefinition carries
/// @@unique([tenantId, role]), so a FieldRole is a fact about the tenant, and
/// ClientFieldResolver (called from PDF, email, search and dashboard code that
/// has no form in scope) could not answer "the client's email" if that depended
/// on which form happened to be open.
model ClientForm {
  id                      String    @id
  tenantId                String
  name                    String
  description             String?
  /// Exactly one per tenant. This is the form the internal client create/edit
  /// page renders, and the only one that shows fields not yet placed on it.
  isDefault               Boolean   @default(false)
  /// FormStatus: DRAFT | PUBLISHED | ARCHIVED. A plain String for the same
  /// reason CustomFieldDefinition.fieldType is — the authoritative list lives
  /// in src/forms/domain/enums/FormStatus.ts and new values cost no migration.
  status                  String    @default("DRAFT")
  /// The section/item tree — see src/forms/domain/value-objects/FormLayout.ts.
  /// Sections and items are deliberately NOT tables. Presentation metadata
  /// (help text, accent colour, column span, placeholder) churns constantly,
  /// and every new attribute would otherwise cost a Postgres migration folder
  /// AND a hand-written MySQL script, because schema.mysql.prisma is maintained
  /// by hand. `options` and `customFieldValues` are already Json here for the
  /// same reason. The price — no FK from an item to its definition — is paid on
  /// read: the read model resolves each fieldId against the tenant's live
  /// definitions and drops orphans, exactly as ClientFieldResolver already
  /// tolerates a deleted roled field.
  ///
  /// No @default: MySQL cannot take a literal default on a JSON column, and the
  /// application always writes it (same as Client.customFieldValues).
  layout                  Json
  /// Optimistic concurrency counter, bumped on every layout write. A layout is
  /// a whole document, so a lost update costs an entire builder session rather
  /// than one field — updates are compare-and-set on this value.
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  /// Soft delete, so a form that already produced clients keeps its identity.
  deletedAt               DateTime?
  /// Randomly-generated public share token (43 chars, base64url of 32 bytes),
  /// minted on first publish. NULL until then. This is what stands in for
  /// authentication on the client-facing fill route — same design as
  /// Quotation's share token, see src/quotations/domain/shareToken.ts.
  shareToken              String?   @unique
  /// A template is a form kept as a reusable starting point rather than one
  /// clients fill. Creating a form FROM a template deep-copies the document,
  /// so later edits to either side never propagate (spec §30).
  isTemplate              Boolean   @default(false)
  /// The FormVersion clients currently submit against. NULL until first
  /// publish. Deliberately NOT a relation field: FormVersion.formId already
  /// points back here, and a second FK in the opposite direction would make
  /// both rows un-deletable without a two-step dance.
  publishedVersionId      String?
  /// The draft `version` counter's value at the moment of the last publish.
  /// NULL until first publish. This is what "unpublished changes" is computed
  /// from (`version > publishedAtDraftVersion`) without ever diffing the
  /// draft document against the frozen FormVersion snapshot — every mutator
  /// already bumps `version`, so this is a cheap integer comparison instead
  /// of a document walk on every read.
  publishedAtDraftVersion Int?
  /// Submission settings — success message, notification recipients, whether
  /// the form is still accepting responses. Json for the same reason `layout`
  /// is: these knobs churn, and each new one would otherwise cost a Postgres
  /// migration AND a hand-written MySQL script.
  ///
  /// No @default: MySQL cannot take a literal default on a JSON column.
  settings                Json

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  versions    FormVersion[]
  submissions FormSubmission[]

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

/// An immutable published snapshot of a form's document.
///
/// The DRAFT document lives on ClientForm.layout and is mutable; publishing
/// copies it here and stamps ClientForm.publishedVersionId. Historical rows
/// are NEVER deleted — a FormSubmission is pinned to the exact version it was
/// submitted against, and deleting the version would make that submission
/// unrenderable (spec §28, brief §8).
model FormVersion {
  id                String   @id
  tenantId          String
  formId            String
  /// 1-based, monotonically increasing per form.
  versionNumber     Int
  /// The frozen FormDocument (v3) — see src/forms/domain/value-objects/FormDocument.ts.
  document          Json
  publishedAt       DateTime @default(now())
  publishedByUserId String?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  form        ClientForm       @relation(fields: [formId], references: [id])
  submissions FormSubmission[]

  @@unique([formId, versionNumber])
  @@index([tenantId, formId])
}

/// One completed response to a published form version.
///
/// `data` is a structured, machine-readable object keyed by FieldSpec.key —
/// never OCR'd or parsed back out of a PDF (spec §27). Print output is a
/// RENDERING of this row, not its source of truth.
model FormSubmission {
  id                String   @id
  tenantId          String
  formId            String
  /// Pins the submission to the exact document that produced it, so a later
  /// republish can never retroactively reinterpret what these values meant.
  formVersionId     String
  data              Json
  submittedAt       DateTime @default(now())
  /// NULL for a public submission — the person filling a shared link has no
  /// account (that is the whole point of the share token).
  submittedByUserId String?
  /// Set when the form carried client-bound fields and a Client row was
  /// created/updated from this submission.
  clientId          String?
  /// How it arrived: PUBLIC_LINK | INTERNAL.
  source            String   @default("PUBLIC_LINK")
  /// Salted hash, not a raw IP — enough to spot abuse, not PII retention.
  ipHash            String?
  userAgent         String?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  form        ClientForm  @relation(fields: [formId], references: [id])
  formVersion FormVersion @relation(fields: [formVersionId], references: [id])

  @@index([tenantId, formId, submittedAt])
  @@index([tenantId, submittedAt])
}

// ==========================================
// CONTRACTS MODULE
// ==========================================

/// A subscription a business (Client) has bought: one TERM, with its own
/// start, end, price and payment schedule.
///
/// Deliberately NOT the same thing as `Tenant.subscriptionStatus`, which says
/// whether THIS workspace may operate. That is the platform billing its
/// tenants; this is a tenant billing its own customers. The two are different
/// directions of the same word and must never be conflated — a SUSPENDED
/// tenant is locked out of the product, whereas a CANCELLED contract is just a
/// business fact about one of that tenant's clients.
///
/// One row per TERM, not per customer relationship. Renewing does not mutate
/// dates in place — it creates the next Contract pointing back at this one
/// through `renewedFromContractId`, so "what did they pay us in 2025" stays
/// answerable after the 2026 renewal. Same snapshot reasoning as
/// InvoiceLineItem copying its product price rather than referencing it.
model Contract {
  id       String @id
  tenantId String
  clientId String

  /// Which staff member owns this account. Nullable and `onDelete: Restrict`
  /// via the relation below, same as Client.assignedUserId: a deactivated
  /// salesperson must not drag their contracts out of the database with them.
  /// Drives "my contracts" filtering and who receives the expiry notification.
  assignedUserId String?

  /// The plan sold, as free text rather than an enum. Medwork's plan list is
  /// commercial, not structural — it changes with a price sheet, and a schema
  /// migration is the wrong unit of work for "we renamed Gold to Premium".
  planName String

  /// DRAFT | PENDING_SIGNATURE | ACTIVE | SUSPENDED | EXPIRED | CANCELLED —
  /// see ContractStatus in src/contracts/domain/Contract.ts. A String column
  /// for the same reason every other status here is one: the authoritative
  /// list is the TypeScript enum, and adding a value needs no migration.
  status String

  /// Price for ONE billing period, not for the whole term. A 1200/year plan
  /// billed MONTHLY stores 100 here, and the term's total is derived by
  /// multiplying by the generated schedule length — storing both a period
  /// price and a term total is how the two drift apart.
  /// M3 Slice 4: Decimal(12,2), never Float (NFR-ACC-03). For a contract made
  /// from a deal this is the agreed monthly price, copied and read only.
  amount Decimal @db.Decimal(12, 2)

  /// MONTHLY | QUARTERLY | ANNUAL | ONE_TIME — how often `amount` falls due.
  /// Determines how many ContractPayment rows activation generates.
  billingPeriod String

  startsAt DateTime
  /// Last day the term covers. The expiry sweep compares this against now.
  endsAt   DateTime

  /// Internal notes, private to the workspace. A dedicated column rather than
  /// a custom field, same rationale as Client.notes.
  notes String?

  /// The signed contract document, if one was uploaded. Stored as a public
  /// `/uploads/...` URL like ProductImage.url, but written by the contract
  /// document endpoint rather than MediaService: this is a PDF kept verbatim,
  /// not an image to be re-encoded through sharp.
  documentUrl  String?
  /// Original filename, so a download can be offered under the name the user
  /// recognises rather than the UUID the file is stored as.
  documentName String?

  /// The term this one renewed, if any. Unique because a term can be renewed
  /// exactly once — a second renewal of the same term would mean two live
  /// successors and no answer to "which one is current". The constraint is in
  /// the database rather than only in RenewContractUseCase for the same reason
  /// Invoice.quotationId is: the use case's check is not atomic.
  renewedFromContractId String? @unique

  /// M3 Slice 4 (D1): the won deal this contract was made from. @unique, so
  /// the database allows one contract per deal (NFR-DAT-01). NULL is a
  /// Legacy contract: no deal, readable and editable through the old paths.
  dealId              String?   @unique
  /// The offer that won the deal, and the package and services it sold,
  /// copied when the contract is made or refreshed (FR-CON-03, 04).
  quotationId         String?
  packageId           String?
  servicesSnapshot    Json?
  /// The offer's terms as `{ sq, en }` rich-text documents (M2 D10).
  termsText           Json?
  agreedAnnualValue   Decimal?  @db.Decimal(12, 2)
  discountPercent     Decimal?  @db.Decimal(7, 2)
  /// CTR-2026-0001 (FR-CON-05, D3). NULL on a Legacy contract.
  number              String?
  /// The date by which a renewal should be agreed (FR-CON-07).
  renewalDate         DateTime? @db.Date
  /// Lifecycle columns Slice 5 writes; created here so one migration owns the table.
  lockedAt            DateTime?
  suspendedAt         DateTime?
  suspensionReason    String?
  cancelReason        String?
  notRenewingReasonId String?
  notRenewingNote     String?

  activatedAt DateTime?
  cancelledAt DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  client       Client @relation(fields: [clientId], references: [id])
  assignedUser User?  @relation("AssignedContracts", fields: [assignedUserId], references: [id], onDelete: Restrict)
  createdBy    User   @relation("CreatedContracts", fields: [createdByUserId], references: [id], onDelete: Restrict)

  renewedFrom Contract? @relation("ContractRenewal", fields: [renewedFromContractId], references: [id], onDelete: Restrict)
  renewedInto Contract? @relation("ContractRenewal")
  /// M3 Slice 10: the Renewal deals started from this contract (D9); at most one is open.
  renewalDeals Deal[] @relation("DealRenewalOf")

  deal              Deal?           @relation(fields: [dealId], references: [id], onDelete: Restrict)
  quotation         Quotation?      @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  package           ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  notRenewingReason LostReason?     @relation("ContractNotRenewingReason", fields: [notRenewingReasonId], references: [id], onDelete: Restrict)

  payments      ContractPayment[]
  statusHistory ContractStatusHistory[]
  documents     ContractDocument[]
  /// M3 Slice 11: the renewal reminders sent or skipped, one per lead time (FR-REN-03).
  reminders     ContractReminder[]

  @@unique([tenantId, number])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([quotationId])
  @@index([packageId])
  @@index([notRenewingReasonId])
  /// Drives the expiry sweep, which scans ACTIVE contracts by end date across
  /// all tenants rather than within one — same shape as Invoice's
  /// `[status, dueDate]`, for the same reason.
  @@index([status, endsAt])
}

/// One expected payment against a contract: "the March instalment".
///
/// There is no payment provider anywhere in this module and that is by design
/// — nothing here talks to a gateway, reconciles a webhook or holds a card.
/// A person collects the money however they collect it (bank transfer, cash,
/// standing order) and records that fact here by hand. `status` is therefore
/// a human assertion, not a system observation.
///
/// Rows are generated up front by ActivateContractUseCase so the schedule is
/// visible before any money moves, and stay fully editable afterwards: real
/// billing has part-payments, waived months and off-cycle extras.
model ContractPayment {
  id         String @id
  tenantId   String
  contractId String

  /// 1-based position within the generated schedule. Not a unique key — an
  /// ad-hoc payment added later shares the index of the period it falls in,
  /// which is correct: two payments can belong to the same month.
  periodIndex Int

  dueDate DateTime
  /// What is owed for this period. Copied from Contract.amount at generation
  /// time, then independently editable — a mid-term price change must not
  /// rewrite instalments the customer already paid at the old rate.
  /// Decimal(12,2) since M3 Slice 4 (NFR-ACC-03).
  amount  Decimal  @db.Decimal(12, 2)

  /// NOT_INVOICED | INVOICE_ISSUED | PAYMENT_PENDING | PARTIALLY_PAID | PAID |
  /// OVERDUE — see PaymentStatus in src/contracts/domain/ContractPayment.ts.
  /// WAIVED is a hidden legacy key (D6): rows already on it keep it, but it
  /// is not offered for new payments.
  status String @default("NOT_INVOICED")

  /// How much has actually landed. Equals `amount` for PAID and 0 for UNPAID;
  /// the field exists for PARTIAL, which is the only state where "how much is
  /// still owed" cannot be derived from the status alone.
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  /// M3 Slice 4 (FR-PAY-02..): the invoice this instalment was billed on, and
  /// when the overdue notice went out (sent once per instalment, FR-PAY-13).
  invoiceNumber     String?
  invoiceDate       DateTime? @db.Date
  overdueNotifiedAt DateTime?

  /// When the money was received — the real-world date the user enters, which
  /// is not the same as when they got round to recording it here.
  paidAt DateTime?

  /// Free text: "bank transfer", "cash", "card at reception". Not an enum,
  /// because the list is whatever this business actually does.
  method String?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  history  ContractPaymentHistory[]

  @@index([tenantId, contractId, dueDate])
  /// Drives the unpaid/overdue rollup across all of a tenant's contracts.
  @@index([tenantId, status, dueDate])
  /// The revenue figure of the KPI engine and the dashboards: money received in a period (M3 Slice 9).
  @@index([tenantId, paidAt])
}

/// Audit trail for a contract's lifecycle transitions, mirroring
/// InvoiceStatusHistory exactly — including the NULL-means-the-scheduler
/// convention on `changedByUserId`, which is what lets an EXPIRED contract's
/// own history explain that time expired it rather than a person.
model ContractStatusHistory {
  id         String @id
  tenantId   String
  contractId String
  fromStatus String
  toStatus   String

  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// `onDelete: Restrict`, stated explicitly — same rationale as
  /// InvoiceStatusHistory.changedBy: deleting a user must not silently rewrite
  /// their past status changes as "done by the scheduler".
  changedBy User?    @relation("ContractStatusChanges", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, contractId])
}

/// One row per change to an instalment (M3 Slice 8, FR-PAY-08): who (NULL is
/// the system), when, the old and new status, the money received in that
/// change and a comment. Every receipt is one row, so this is also the receipt
/// list (D6): `amountReceived` is negative when a receipt is reversed. A
/// change that is not a status move (adding, changing the due date or amount)
/// repeats the status in both columns; adding an instalment has no old status
/// and writes NONE. `receivedOn` and `method` are set on receipts only.
/// `onDelete: Restrict` on the user, as in ContractStatusHistory.
model ContractPaymentHistory {
  id         String @id
  tenantId   String
  paymentId  String
  fromStatus String
  toStatus   String

  amountReceived Decimal   @default(0) @db.Decimal(12, 2)
  receivedOn     DateTime? @db.Date
  method         String?

  changedByUserId String?
  comment         String? @db.Text
  createdAt       DateTime @default(now())

  payment   ContractPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  changedBy User?           @relation("ContractPaymentChanges", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}

/// The signed contract as a PDF, one row per file ever attached (M3 Slice 5,
/// FR-CON-19). Replacing the document keeps the earlier file as a previous
/// version: the new row is current and every other row of the contract is not.
/// `Contract.documentUrl` / `documentName` mirror the current row so the
/// older readers keep working. The file itself is read back only through the
/// contract's document endpoint, which checks `commercial.view` and the
/// contract's scope.
model ContractDocument {
  id               String   @id
  tenantId         String
  contractId       String
  fileName         String
  url              String
  uploadedByUserId String
  uploadedAt       DateTime @default(now())
  isCurrent        Boolean  @default(true)

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("ContractDocumentUploads", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([contractId, isCurrent])
  @@index([tenantId, contractId])
}

/// Admin-managed risk levels (Slice 8: FR-SET-02). A company's risk level is
/// never stored on the company: it is read through its business type (SRS
/// §7.1). `level` is the number the business uses ("Level 1") and is unique
/// in the workspace; `order` is only the display order.
model RiskLevel {
  id          String   @id
  tenantId    String
  level       Int
  nameSq      String
  /// Optional: labels fall back to Albanian when English is missing (FR-LNG-03).
  nameEn      String?
  description String?
  order       Int      @default(0)
  /// A deactivated value stays on the records that use it but is not offered
  /// for new ones. A value in use is never deleted, only deactivated.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessTypes  BusinessType[]
  riskSurcharges RiskSurcharge[]

  @@unique([tenantId, level])
  @@index([tenantId, order])
}

/// Admin-managed business types, each tied to one risk level (Slice 8:
/// FR-SET-01). Same lifecycle as RiskLevel. `Restrict` on the risk level: a
/// risk level a business type points at can be deactivated but not deleted.
model BusinessType {
  id          String   @id
  tenantId    String
  nameSq      String
  nameEn      String?
  riskLevelId String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  riskLevel RiskLevel @relation(fields: [riskLevelId], references: [id], onDelete: Restrict)
  clients   Client[]

  @@index([tenantId, order])
  @@index([riskLevelId])
}

/// Predefined regions (Slice 9: FR-SET-03; Q1: Area = qark). Deactivating an
/// area with active cities is refused unless the caller cascades the
/// deactivation onto them (FR-SET-04).
model Area {
  id        String   @id
  tenantId  String
  nameSq    String
  /// Optional: labels fall back to Albanian when English is missing (FR-LNG-03).
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cities  City[]
  clients Client[]

  @@index([tenantId, order])
}

/// The cities of one area (Slice 9: FR-SET-04). A name is unique within its
/// area, not across the whole workspace, so "Tiranë" can exist once per area.
/// `Restrict` on the area: an area a city points at can be deactivated but
/// not deleted.
model City {
  id        String   @id
  tenantId  String
  areaId    String
  nameSq    String
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area       Area            @relation(fields: [areaId], references: [id], onDelete: Restrict)
  clients    Client[]
  priceZones PriceZoneCity[]

  @@unique([tenantId, areaId, nameSq])
  @@index([tenantId, areaId, order])
  members    Member[]
}

/// Days after which an unattended deal should resurface as a follow-up
/// (Slice 10: FR-SET-05). Nothing reads this list yet; the use case that
/// schedules follow-ups is Milestone 2.
model FollowUpInterval {
  id        String   @id
  tenantId  String
  days      Int
  nameSq    String
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, order])
}

/// Why a deal was marked lost (Slice 10: FR-SET-06). Nothing reads this list
/// yet; the deal that records a reason is Milestone 2.
model LostReason {
  id        String   @id
  tenantId  String
  nameSq    String
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals               Deal[]
  contractsNotRenewed Contract[] @relation("ContractNotRenewingReason")

  @@index([tenantId, order])
}

/// What came of an activity (M2 Slice 7, FR-ACT-03): a lookup list with the
/// same rules as the M1 lists. Seeded with the Q14 defaults; the legacy
/// OutcomeCategory labels were copied in by the Slice 7 migration (D5).
model ActivityResult {
  id        String   @id
  tenantId  String
  nameSq    String
  nameEn    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([tenantId, order])
}

/// The label, order and colour the Administrator has set for one fixed
/// status key (Slice 10: FR-SET-07, 08). `domain` and `key` are both fixed
/// in code (`StatusCatalogue.ts`) — there is no create or delete, only
/// update — so a missing row simply means the catalogue default applies.
model StatusLabel {
  tenantId  String
  domain    String
  key       String
  labelSq   String
  labelEn   String?
  colour    String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, domain, key])
}

/// M2 Slice 3: the workspace-wide pricing values (FR-PCF-07), and from Slice 4
/// the offer settings (FR-PCF-08). One row per workspace. Money and
/// percentages are Decimal, never Float (NFR-ACC-02).
model PricingSettings {
  tenantId              String   @id
  currency              String   @default("EUR")
  /// The highest discount % a salesperson may apply without approval.
  discountCapPercent    Decimal  @default(10) @db.Decimal(7, 2)
  /// Days an offer stays valid after it is marked as sent (Q9).
  offerValidityDays     Int      @default(30)
  /// Contract length the annual value is calculated over (Q6).
  contractMonthsDefault Int      @default(12)
  /// Prefix of the offer number, e.g. "OF" in OF-2026-0001 (Slice 9).
  offerNumberPrefix     String   @default("OF")
  /// The company details printed on the offer.
  companyName           String?
  nipt                  String?
  address               String?
  phone                 String?
  email                 String?
  website               String?
  bankDetails           String?
  /// The standard offer texts as sanitised TipTap JSON (plan D10, NFR-SEC-05).
  introSq               Json?
  introEn               Json?
  termsSq               Json?
  termsEn               Json?
  closingSq             Json?
  closingEn             Json?
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Workspace sales settings (M2 Slice 11), one row per workspace, with the
/// defaults below until the Administrator saves one.
model SalesSettings {
  tenantId      String   @id
  /// An open deal with no activity for this many days is highlighted on the
  /// board and the list (FR-DEAL-12).
  staleDealDays Int      @default(14)
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Workspace contract settings (M3 Slice 3), one row per workspace, created
/// lazily: a workspace with no row is on the defaults below. Reminder lead
/// times (FR-REN-01), the expiring-soon window (FR-REN-04), payment grace days
/// (FR-PAY-09) and the contract number prefix (FR-CON-05).
model ContractSettings {
  tenantId         String   @id
  /// Days before the end date, sorted descending, at most five (FR-REN-01).
  reminderLeadDays Json     @default("[60,30,7]")
  expiringSoonDays Int      @default(30)
  paymentGraceDays Int      @default(0)
  numberPrefix     String   @default("CTR")
  updatedAt        DateTime @updatedAt
  updatedByUserId  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// One renewal reminder of a contract at one lead time (M3 Slice 11, D8,
/// FR-REN-03). `SENT` once the notification was emitted; `SKIPPED` for a lead
/// time already passed when the contract was first looked at. A failed send
/// writes no row, so the next run retries. A renewal contract starts with none.
model ContractReminder {
  id         String   @id
  tenantId   String
  contractId String
  /// Days before the end date this reminder is for.
  leadDays   Int
  /// SENT | SKIPPED
  state      String
  sentAt     DateTime

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, leadDays])
  @@index([tenantId, contractId])
}

/// An employee band of the pricing model (FR-PCF-01): the base fee for the
/// first employee plus a fee per extra employee. Active bands never overlap;
/// that rule lives in the domain (PricingConfigRules).
model EmployeeBand {
  id             String   @id
  tenantId       String
  minEmployees   Int
  maxEmployees   Int
  baseFee        Decimal  @db.Decimal(12, 2)
  perEmployeeFee Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, minEmployees])
}

/// The risk surcharge % of one M1 risk level (FR-PCF-02, plan D2). Kept out
/// of RiskLevel so the commercial number never travels with the lookup list
/// every user can read. A risk level with no row prices as "Price on request".
/// Cascades with its risk level: the surcharge is an attribute of it, and a
/// risk level can only be deleted while no business type uses it.
model RiskSurcharge {
  id          String   @id
  tenantId    String
  riskLevelId String
  percent     Decimal  @db.Decimal(7, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  riskLevel RiskLevel @relation(fields: [riskLevelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, riskLevelId])
  @@index([riskLevelId])
}

/// A visit frequency (FR-PCF-04): a percentage of the base fee, or a fixed
/// monthly amount (`pricingType` PERCENT | FIXED, Q2). `value` is the percent
/// or the amount accordingly.
model VisitFrequency {
  id            String   @id
  tenantId      String
  nameSq        String
  nameEn        String?
  /// Optional, for reports only; it does not change the price.
  visitsPerYear Int?
  pricingType   String
  value         Decimal  @db.Decimal(12, 2)
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Offers priced with this frequency: it is in use (Slice 3), so it can be
  /// deactivated but not deleted.
  offers Quotation[]

  @@index([tenantId, order])
}

/// A price zone (FR-PCF-05): a location surcharge % over a set of predefined
/// M1 cities. A city may be in more than one zone (FR-PRC-06, Q3).
model PriceZone {
  id               String   @id
  tenantId         String
  nameSq           String
  nameEn           String?
  surchargePercent Decimal  @db.Decimal(7, 2)
  order            Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cities PriceZoneCity[]
  offers Quotation[]

  @@index([tenantId, order])
}

/// The cities of a price zone. `Restrict` on the city: a city in a zone is in
/// use (PrismaLookupInUsePolicy), so it can be deactivated but not deleted.
model PriceZoneCity {
  zoneId String
  cityId String

  zone PriceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// Cascade, not RESTRICT: deleting a workspace cascades to City and PriceZone
  /// in no fixed order, and Postgres checks a RESTRICT key inside each cascade
  /// step. A city in a zone still cannot be deleted: PrismaLookupInUsePolicy
  /// counts it as in use (FR-PCF-05), as PackageService does for services.
  city City      @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([zoneId, cityId])
  @@index([cityId])
}

/// M2 Slice 4: a service the offer describes (FR-PCF-06). It has no price:
/// packages describe what the client gets, the pricing model sets the price
/// (Q11).
model Service {
  id            String   @id
  tenantId      String
  nameSq        String
  nameEn        String?
  descriptionSq String?
  descriptionEn String?
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packages   PackageService[]
  offerLines QuotationService[]

  @@index([tenantId, order])
}

/// A named set of services the salesperson picks for an offer (FR-PCF-06).
/// Exactly one active package is the default; that rule lives in the
/// application layer.
model ServicePackage {
  id            String   @id
  tenantId      String
  nameSq        String
  nameEn        String?
  descriptionSq String?
  descriptionEn String?
  isDefault     Boolean  @default(false)
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services  PackageService[]
  deals     Deal[]
  offers    Quotation[]
  contracts Contract[]

  @@index([tenantId, order])
}

/// The services of a package, in the order the offer lists them. A service in
/// a package is in use: it can be deactivated but not deleted, which
/// DeletePricingItemUseCase enforces. The service side cascades rather than
/// restricts because deleting a workspace cascades to Service and
/// ServicePackage in no fixed order, and Postgres checks a RESTRICT (or NO
/// ACTION) key inside each cascade step.
model PackageService {
  packageId String
  serviceId String
  order     Int    @default(0)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageId, serviceId])
  @@index([serviceId])
}

/// M2 Slice 5: the workspace sales script (FR-SCR-03..06). One row per
/// version: at most one DRAFT (what the Administrator is editing) and one
/// PUBLISHED (what salespeople read); every earlier publish is SUPERSEDED and
/// kept, with its author and date (FR-SCR-05). Content is TipTap JSON,
/// sanitised on the server (plan D10, NFR-SEC-05).
///
/// `liveSlot` repeats the status while the row is DRAFT or PUBLISHED and is
/// NULL once SUPERSEDED. A unique index ignores NULLs on Postgres and MySQL
/// alike, so (tenantId, liveSlot) allows one draft and one published version
/// per workspace and any number of superseded ones, with no partial index or
/// generated column.
model SalesScript {
  id                String    @id
  tenantId          String
  version           Int
  status            String // 'DRAFT' | 'PUBLISHED' | 'SUPERSEDED'
  liveSlot          String?
  contentSq         Json
  contentEn         Json?
  createdByUserId   String?
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?  @relation("SalesScriptCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedBy User?  @relation("SalesScriptPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, version])
  @@unique([tenantId, liveSlot])
  @@index([createdByUserId])
  @@index([publishedByUserId])
}

/// A sales opportunity with a company (M2 Slice 6, FR-DEAL-01). A company
/// can have several deals, open or closed. `stageKey` is one of the fixed
/// DEAL keys in StatusCatalogue.ts (FR-DEAL-06); the Administrator renames
/// them through StatusLabel, never here. `type` is NEW_CONTRACT | RENEWAL |
/// EXTRA_SERVICES, a String column like every other status in this schema.
/// `title` NULL means the default "<company> – <type>", rendered in the
/// reader's language.
///
/// The won and lost columns are filled by Slice 13; they are created now so
/// the table is created once. The agreed values stay on the deal because a
/// won deal feeds the Milestone 3 contract (SRS §7.3 note).
model Deal {
  id                String    @id
  tenantId          String
  clientId          String
  ownerUserId       String
  type              String
  title             String?
  stageKey          String
  expectedCloseDate DateTime?
  notes             String?
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  closedAt          DateTime?
  // Soft delete (FR-DEAL-19). NULL means live; every read filters on it.
  deletedAt         DateTime?

  // Filled when the deal is won or lost (Slice 13).
  wonAt              DateTime?
  lostAt             DateTime?
  lostReasonId       String?
  lostNote           String?
  agreedMonthlyPrice Decimal?  @db.Decimal(12, 2)
  agreedAnnualValue  Decimal?  @db.Decimal(12, 2)
  packageId          String?
  wonQuotationId     String?

  /// M3 Slice 10 (FR-REN-06): the contract this Renewal deal renews. NULL on every other deal.
  renewalOfContractId String?

  /// The current offer's net monthly price and annual value (Slice 8), copied
  /// in the transaction that saves the offer, so the board totals, the value
  /// filter and the value sort read one indexed column (FR-DEAL-10, 11).
  offerNetMonthlyPrice Decimal? @db.Decimal(12, 2)
  offerAnnualValue     Decimal? @db.Decimal(12, 2)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Restrict, as Client.assignedUser: users are deactivated, never deleted.
  owner        User               @relation("DealOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("DealCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lostReason   LostReason?        @relation(fields: [lostReasonId], references: [id], onDelete: Restrict)
  package      ServicePackage?    @relation(fields: [packageId], references: [id], onDelete: Restrict)
  wonQuotation Quotation?         @relation("DealWonQuotation", fields: [wonQuotationId], references: [id], onDelete: Restrict)
  renewalOf    Contract?          @relation("DealRenewalOf", fields: [renewalOfContractId], references: [id], onDelete: Restrict)
  stageHistory DealStageHistory[]
  contract     Contract?
  interactions Interaction[]
  offers       Quotation[]        @relation("DealOffers")
  /// M2 Slice 11: its follow-ups (FR-DEAL-03).
  appointments Appointment[]

  @@index([tenantId, ownerUserId, stageKey])
  @@index([tenantId, clientId])
  @@index([tenantId, stageKey, updatedAt])
  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([lostReasonId])
  @@index([packageId])
  @@index([wonQuotationId])
  @@index([tenantId, stageKey, offerNetMonthlyPrice])
  /// M3 Slice 12: the period queries of the Performance screen and dashboards.
  @@index([tenantId, wonAt])
  @@index([tenantId, lostAt])
  @@index([renewalOfContractId])
}

/// Every stage change of a deal (FR-DEAL-09): from, to, who and when. The
/// first row of a deal has no `fromStage`. `changedByUserId` NULL means the
/// platform moved the deal (FR-DEAL-08), so the user key restricts rather
/// than sets null: deleting a user must not turn their moves into
/// "automatic". Milestone 3 reads the time spent in each stage from here.
model DealStageHistory {
  id              String   @id
  tenantId        String
  dealId          String
  fromStage       String?
  toStage         String
  changedByUserId String?
  /// M3 Slice 12 (D13, FR-PRF-05): the deal's owner when this change happened.
  /// Won and lost are attributed from here, so reassigning a deal later does
  /// not move its result. Rows from before Slice 12 took the deal's owner then.
  ownerUserId     String?
  at              DateTime @default(now())
  note            String?

  deal      Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  changedBy User? @relation("DealStageChanges", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, dealId, at])
  @@index([dealId])
  @@index([changedByUserId])
  @@index([tenantId, ownerUserId, toStage, at])
}

/// Wellness+ tier label, colour, fee and term (M4 Slice 3, FR-TIR-01). Four rows
/// per workspace, one per fixed tier; Bronze has neither fee nor term, VIP has
/// a term and no fee. Fee is money: Decimal(12,2) (NFR-ACC-05).
model TierSetting {
  tenantId        String
  tier            String
  labelSq         String
  labelEn         String
  colour          String
  fee             Decimal? @db.Decimal(12, 2)
  termMonths      Int?
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, tier])
}

/// Workspace Wellness+ rules (M4 Slice 3), one row per workspace, created
/// lazily: no row means the defaults in DefaultMembership.ts.
model MembershipSettings {
  tenantId              String   @id
  familyDiscountPercent Decimal  @default(50) @db.Decimal(7, 2)
  graceDays             Int      @default(0)
  expiringSoonDays      Int      @default(30)
  memberPrefix          String   @default("WP")
  receiptPrefix         String   @default("RCP")
  vipReviewNoticeDays   Int      @default(30)
  updatedAt             DateTime @updatedAt
  updatedByUserId       String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// The family relationship choice list (M4 Slice 3, FR-FAM-02).
model FamilyRelationship {
  id       String  @id
  tenantId String
  nameSq   String
  nameEn   String
  order    Int     @default(0)
  active   Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, order])
  members  Member[]
}

/// A service in the Wellness+ benefit table (M4 Slice 3, FR-BEN-01).
model BenefitService {
  id       String  @id
  tenantId String
  nameSq   String
  nameEn   String
  order    Int     @default(0)
  active   Boolean @default(true)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discounts BenefitDiscount[]

  @@index([tenantId, order])
}

/// The discount of one service for one tier; no row means no discount.
model BenefitDiscount {
  serviceId String
  tier      String
  percent   Decimal @db.Decimal(5, 2)

  service BenefitService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, tier])
}

/// A Wellness+ member (M4 Slice 4, FR-MEM-02). Not a Client and not a User. The
/// columns are exactly the FR-MEM-02 list plus the keys the later slices link
/// through; no medical, address, photograph or national-ID column exists
/// (FR-DPR-01, FR-DPR-03). `currentTier` is a stored copy kept by the domain
/// actions and the daily job; single-member reads calculate it (D2).
model Member {
  id                      String    @id
  tenantId                String
  memberNumber            String
  firstName               String
  lastName                String
  dateOfBirth             DateTime? @db.Date
  phone                   String?
  email                   String?
  language                String    @default("sq")
  cityId                  String?
  status                  String    @default("ACTIVE")
  currentTier             String    @default("BRONZE")
  startsOn                DateTime  @db.Date
  employerClientId        String?
  formerEmployerClientId  String?
  leftCompanyAt           DateTime? @db.Date
  principalMemberId       String?
  relationshipId          String?
  relationshipConfirmedBy String?
  relationshipConfirmedAt DateTime?
  /// The secret behind the member's card link (Slice 11). Never audited or logged.
  cardToken               String    @unique
  note                    String?   @db.Text
  createdBy               String
  createdAt               DateTime  @default(now())
  closedAt                DateTime?
  anonymisedAt            DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  city           City?               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  employer       Client?             @relation("MemberEmployer", fields: [employerClientId], references: [id], onDelete: Restrict)
  formerEmployer Client?             @relation("MemberFormerEmployer", fields: [formerEmployerClientId], references: [id], onDelete: Restrict)
  principal      Member?             @relation("MemberFamily", fields: [principalMemberId], references: [id], onDelete: Restrict)
  dependants     Member[]            @relation("MemberFamily")
  relationship   FamilyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Restrict)
  terms          MemberTerm[]
  tierHistory    MemberTierHistory[]
  statusHistory  MemberStatusHistory[]
  payments       MemberPayment[]

  @@unique([tenantId, memberNumber])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, currentTier, status])
  @@index([tenantId, employerClientId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, dateOfBirth])
  @@index([principalMemberId])
}

/// One term of membership (M4 Slice 4, D3). A new member has none: Bronze is
/// the floor. A sponsored term has no end date. The payment columns are filled
/// by Slice 5, `followsTermId` by the daily job of Slice 8 (one downgrade term
/// per ended term, enforced here by the unique index).
model MemberTerm {
  id                     String    @id
  memberId               String
  tier                   String
  source                 String
  startsOn               DateTime  @db.Date
  endsOn                 DateTime? @db.Date
  paymentId              String?
  followsTermId          String?   @unique
  closedEarlyByPaymentId String?
  originalEndsOn         DateTime? @db.Date
  createdAt              DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, startsOn])
}

/// Every change of effective tier (M4 Slice 4, FR-TIR-08). `changedByUserId`
/// is null for the system.
model MemberTierHistory {
  id              String   @id
  memberId        String
  fromTier        String
  toTier          String
  reason          String
  comment         String?  @db.Text
  changedByUserId String?
  createdAt       DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

/// Every change of status (M4 Slice 4, FR-MEM-05, D15): the history the monthly
/// "Active at the end of the month" report replays.
model MemberStatusHistory {
  id              String   @id
  memberId        String
  fromStatus      String?
  toStatus        String
  reason          String?  @db.Text
  changedByUserId String?
  createdAt       DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

/// A membership payment (M4 Slice 5, FR-MPAY-01..11, D6). Immutable except for
/// the three void columns: the list fee, the discount and the amount are stored
/// so a later change of fee or discount never changes it (FR-MPAY-10).
model MemberPayment {
  id              String    @id
  tenantId        String
  memberId        String
  kind            String
  fromTier        String
  toTier          String
  listFee         Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @db.Decimal(7, 2)
  amount          Decimal   @db.Decimal(12, 2)
  method          String
  receivedOn      DateTime  @db.Date
  receiptNumber   String
  note            String?   @db.Text
  recordedBy      String
  createdAt       DateTime  @default(now())
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?   @db.Text

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, receivedOn])
  @@index([memberId, createdAt])
}
