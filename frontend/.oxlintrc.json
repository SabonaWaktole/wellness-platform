{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/jsx-no-literals": [
      "error",
      {
        "allowedStrings": [
          "/",
          "—",
          "-",
          "·",
          ">",
          "@",
          "+",
          "%"
        ],
        "ignoreProps": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.stories.tsx",
        "**/*.stories.ts"
      ],
      "rules": {
        "react/jsx-no-literals": "off"
      }
    },
    {
      "files": [
        "src/pages/pricing/**",
        "src/components/pricing/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "decimal.js",
                "message": "The pricing screen shows the server's amounts; it never calculates a price (NFR-ACC-02)."
              },
              {
                "name": "big.js",
                "message": "The pricing screen shows the server's amounts; it never calculates a price (NFR-ACC-02)."
              },
              {
                "name": "bignumber.js",
                "message": "The pricing screen shows the server's amounts; it never calculates a price (NFR-ACC-02)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/utils/paymentSchedule"
                ],
                "message": "The pricing screen shows the server's amounts; it never calculates a price (NFR-ACC-02)."
              }
            ]
          }
        ]
      }
    }
  ]
}
