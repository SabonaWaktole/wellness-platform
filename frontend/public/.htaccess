# SPA routing for Apache/LiteSpeed (Hostinger).
#
# `vercel.json` next to this file expresses the same rule, but only Vercel
# reads it. On Apache a reload of /bole-electronics-depot/ is a request for a
# directory that does not exist on disk — the router that knows about it is in
# JavaScript that has not loaded yet — so the server 404s before the SPA ever
# runs. Client-side navigation works because no request is made at all.
#
# Lives in public/ rather than dist/ so Vite copies it into every build; dist
# is gitignored and rebuilt from scratch.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # NFR-SEC-02: plain HTTP is redirected to HTTPS before anything else. The
  # X-Forwarded-Proto check keeps this from looping behind a TLS-terminating
  # proxy that talks plain HTTP to the origin.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Real files and directories are served as-is. Without these two conditions
  # the rule below would swallow /assets/*.js and hand back index.html with a
  # 200, which surfaces as "Unexpected token '<'" rather than as a 404.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: serve the shell and let the router
  # resolve the path.
  RewriteRule ^ index.html [L]
</IfModule>

# index.html must not be cached: it names the hashed bundles, so a stale copy
# points at assets that no longer exist after a redeploy. The hashed assets
# themselves are immutable and safe to cache hard.
<IfModule mod_headers.c>
  # NFR-SEC-02: once a browser has seen the site over HTTPS it refuses plain
  # HTTP for a year (browsers ignore this header on a plain-HTTP response).
  # No includeSubDomains: other subdomains of the client's domain are not ours.
  # The API sets its own header through helmet.
  Header always set Strict-Transport-Security "max-age=31536000"

  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|gif|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # M4 Slice 12 (D14): the card's service worker is never cached, so a fix to it
  # reaches phones at the next open, and it may control /m/ and nothing else. This
  # comes after the rule above, which would otherwise make every .js immutable.
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/m/"
  </Files>
</IfModule>
