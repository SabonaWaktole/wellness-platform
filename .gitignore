# Repo-root env files. The patterns below require a directory prefix, so a bare
# root-level .env would otherwise be tracked.
.env
.env.*
*/.env
*/.env.*
frontend/design/
.agentrules

# Deployment archives — rebuilt from source by deploy/package.py, never a
# source of truth themselves.
deploy/*.zip

# Client documents (kept locally, not versioned)
/docs/
